---
type Props = {
  study: {
    title: string;
    category: string;
    label: string;
    context: string;
    challenge: string;
    scope: string;
    strategy: string;
    deliverables: string;
    impact: string;
  };
};
const { study } = Astro.props;
---

<article class="reveal rounded-md border border-slate-200 bg-white p-7 shadow-crisp" data-case-card={study.category}>
  <div class="flex flex-wrap gap-2">
    <span class="rounded-full bg-energy-400/12 px-3 py-1 text-xs font-bold text-energy-700">{study.category}</span>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{study.label}</span>
  </div>
  <h2 class="mt-5 text-2xl font-semibold tracking-normal text-slate-950">{study.title}</h2>
  <div class="mt-6 grid gap-4 text-sm leading-7 text-slate-600">
    <p><strong class="text-slate-950">Contexto: </strong>{study.context}</p>
    <p><strong class="text-slate-950">Desafio: </strong>{study.challenge}</p>
    <p><strong class="text-slate-950">Escopo técnico: </strong>{study.scope}</p>
    <p><strong class="text-slate-950">Estratégia: </strong>{study.strategy}</p>
    <p><strong class="text-slate-950">Entregáveis: </strong>{study.deliverables}</p>
    <p><strong class="text-slate-950">Impacto esperado: </strong>{study.impact}</p>
  </div>
</article>
