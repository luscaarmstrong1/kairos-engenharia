---
type Props = {
  study: {
    title: string;
    category: string;
    label: string;
    context: string;
    challenge: string;
    scope: string;
    strategy: string;
    deliverables: string;
    impact: string;
  };
};
const { study } = Astro.props;
---

<article class="cx-card reveal p-7" data-case-card={study.category}>
  <div class="flex flex-wrap gap-2">
    <span class="rounded-full border border-cx-cyan/25 bg-cx-cyan/10 px-3 py-1 text-xs font-bold text-cx-cyan">{study.category}</span>
    <span class="rounded-full border border-white/10 bg-white/6 px-3 py-1 text-xs font-semibold text-cx-muted">{study.label}</span>
  </div>
  <h2 class="mt-5 text-2xl font-semibold tracking-normal text-cx-text">{study.title}</h2>
  <div class="mt-6 grid gap-4 text-sm leading-7 text-cx-muted">
    <p><strong class="text-cx-text">Contexto: </strong>{study.context}</p>
    <p><strong class="text-cx-text">Desafio: </strong>{study.challenge}</p>
    <p><strong class="text-cx-text">Escopo técnico: </strong>{study.scope}</p>
    <p><strong class="text-cx-text">Estratégia: </strong>{study.strategy}</p>
    <p><strong class="text-cx-text">Entregáveis: </strong>{study.deliverables}</p>
    <p><strong class="text-cx-text">Impacto esperado: </strong>{study.impact}</p>
  </div>
</article>
