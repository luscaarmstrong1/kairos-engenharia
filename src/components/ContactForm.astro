---
import Field from "@components/Field.astro";
import SelectField from "@components/SelectField.astro";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || "";
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const calendarUrl = import.meta.env.PUBLIC_CALENDAR_URL || "";

const demandTypes = [
  "Engenharia e Projetos Elétricos",
  "Consultoria Técnico-Regulatória",
  "Perícia / Quesitos / Parecer Técnico",
  "Outro",
];
---

<form
  class="rounded-[8px] border border-[#18211F]/12 bg-white p-6 shadow-md sm:p-8 font-sans-tech"
  data-contact-form
  data-endpoint={endpoint}
  data-turnstile={turnstile}
  data-calendar={calendarUrl}
  novalidate
>
  <div class="space-y-4">
    <Field id="nome" label="Nome *" maxlength="80" />
    <Field id="empresa" label="Empresa *" maxlength="120" />
    <Field id="email" label="E-mail *" type="email" maxlength="120" />
    <Field id="telefone" label="Telefone / WhatsApp *" placeholder="(11) 99999-9999" maxlength="15" />

    <SelectField id="perfil" label="Tipo de demanda *" options={demandTypes} />

    <div>
      <label for="mensagem" class="block text-xs font-semibold uppercase tracking-wider text-[#18211F]">
        Mensagem / Descrição do caso *
      </label>
      <textarea
        id="mensagem"
        name="mensagem"
        rows="4"
        maxlength="1600"
        data-field="mensagem"
        class="mt-1.5 w-full resize-none rounded-[6px] border border-[#18211F]/20 bg-[#F7F4EC] px-3.5 py-2.5 text-xs text-[#001F1A] outline-none transition placeholder:text-[#A7ACA8] focus:border-[#C79A3B] focus:bg-white"
        placeholder="Descreva brevemente a demanda técnica, projeto ou processo regulatório."
      ></textarea>
      <p class="mt-1 hidden text-xs font-medium text-red-600" id="mensagem-error" data-error="mensagem"></p>
    </div>

    <!-- Honeypot -->
    <label class="hidden" aria-hidden="true">
      Website
      <input name="website" tabindex="-1" autocomplete="off" data-field="website" />
    </label>
  </div>

  <div class="mt-5">
    <label class="flex items-start gap-2.5 text-xs leading-relaxed text-[#303735]/80" for="lgpd">
      <input id="lgpd" name="lgpd" type="checkbox" data-field="lgpd" class="mt-0.5 h-3.5 w-3.5 rounded border-[#D8D8D5] text-[#D7A536]" />
      <span>Autorizo o contato da Conexium Engenharia para retorno sobre esta solicitação técnica, nos termos da Lei Geral de Proteção de Dados (LGPD).</span>
    </label>
    <p class="mt-1 hidden text-xs font-medium text-red-600" id="lgpd-error" data-error="lgpd"></p>
  </div>

  <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-3">
    <button type="submit" class="btn-gold w-full sm:w-auto" data-submit-label="Solicitar avaliação técnica">
      <span data-submit-text>Solicitar avaliação técnica</span>
      <span class="ml-1.5" aria-hidden="true">→</span>
    </button>
  </div>

  <p class="mt-4 hidden rounded-lg border border-[#00302B]/20 bg-[#FAF8F3] px-4 py-3 text-xs font-medium text-[#001816]" role="status" aria-live="polite" data-feedback></p>
</form>

<script>
  // @ts-nocheck
  import { formatPhone, sanitizeText, scoreLead, validateLead } from "../lib/forms";

  function setError(form, field, message) {
    const error = form.querySelector(`[data-error="${field}"]`);
    const input = form.querySelector(`[data-field="${field}"]`);
    if (error) {
      error.textContent = message || "";
      error.classList.toggle("hidden", !message);
    }
    input?.setAttribute("aria-invalid", message ? "true" : "false");
  }

  function readForm(form) {
    const get = (name) => form.querySelector(`[data-field="${name}"]`);
    return {
      nome: get("nome")?.value || "",
      empresa: get("empresa")?.value || "",
      email: get("email")?.value || "",
      telefone: get("telefone")?.value || "",
      perfil: get("perfil")?.value || "",
      mensagem: get("mensagem")?.value || "",
      lgpd: Boolean(get("lgpd")?.checked),
      website: get("website")?.value || "",
    };
  }

  document.querySelectorAll("[data-contact-form]").forEach((form) => {
    // Pre-selecionar tipo de demanda a partir de parâmetro de URL (?servico=...)
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const servicoParam = urlParams.get("servico");
      if (servicoParam) {
        const select = form.querySelector('[data-field="perfil"]');
        if (select) {
          if (servicoParam.includes("projeto") || servicoParam.includes("eletrico")) {
            select.value = "Engenharia e Projetos Elétricos";
          } else if (servicoParam.includes("regulat") || servicoParam.includes("consultoria")) {
            select.value = "Consultoria Técnico-Regulatória";
          } else if (servicoParam.includes("pericia") || servicoParam.includes("parecer")) {
            select.value = "Perícia / Quesitos / Parecer Técnico";
          }
        }
      }
    } catch (e) {
      // Ignora falhas de parse de URL
    }

    form.querySelector('[data-field="telefone"]')?.addEventListener("input", (event) => {
      event.currentTarget.value = formatPhone(event.currentTarget.value);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const feedback = form.querySelector("[data-feedback]");
      const submit = form.querySelector("button[type='submit']");
      const submitText = form.querySelector("[data-submit-text]");
      feedback?.classList.add("hidden");

      const raw = readForm(form);
      const errors = validateLead(raw);
      for (const field of ["nome", "empresa", "email", "telefone", "perfil", "mensagem", "lgpd", "website"]) {
        setError(form, field, errors[field] || "");
      }
      if (Object.keys(errors).length) return;

      const endpoint = form.getAttribute("data-endpoint") || "";
      const payload = {
        ...Object.fromEntries(Object.entries(raw).map(([key, value]) => [key, typeof value === "string" ? sanitizeText(value) : value])),
        leadScore: scoreLead(raw),
        submittedAt: new Date().toISOString(),
      };

      if (!endpoint) {
        if (feedback) {
          feedback.className = "mt-4 block rounded-lg border border-[#C79A3B]/40 bg-[#001F1A] px-4 py-3 text-xs font-medium text-[#F7F4EC]";
          feedback.innerHTML = `O canal de envio automático direto está em manutenção técnica. Por favor, envie sua demanda diretamente para o e-mail oficial: <a href="mailto:conexiumengenharia@gmail.com" class="text-[#C79A3B] underline font-bold">conexiumengenharia@gmail.com</a> ou pelo WhatsApp: <a href="https://wa.me/551138429930" class="text-[#C79A3B] underline font-bold">+55 11 3842-9930</a>.`;
        }
        return;
      }

      try {
        submit?.setAttribute("disabled", "true");
        if (submitText) submitText.textContent = "Enviando...";
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error("Falha no endpoint");
        if (feedback) {
          feedback.className = "mt-4 block rounded-lg border border-emerald-600/30 bg-emerald-950/40 px-4 py-3 text-xs font-medium text-emerald-200";
          feedback.textContent = "Solicitação recebida com sucesso. As informações foram encaminhadas para análise inicial. O retorno será realizado pelos contatos informados.";
        }
        form.reset();
      } catch {
        if (feedback) {
          feedback.className = "mt-4 block rounded-lg border border-red-500/30 bg-red-950/40 px-4 py-3 text-xs font-medium text-red-200";
          feedback.innerHTML = `Não foi possível confirmar o recebimento automático no momento. Para garantir seu atendimento, favor encaminhar sua solicitação para o e-mail: <a href="mailto:conexiumengenharia@gmail.com" class="text-[#C79A3B] underline font-bold">conexiumengenharia@gmail.com</a> ou WhatsApp: <a href="https://wa.me/551138429930" class="text-[#C79A3B] underline font-bold">+55 11 3842-9930</a>.`;
        }
      } finally {
        submit?.removeAttribute("disabled");
        if (submitText) submitText.textContent = "Solicitar avaliação técnica";
      }
    });
  });
</script>
