---
import Field from "@components/Field.astro";
import SelectField from "@components/SelectField.astro";
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || "";
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const calendarUrl = import.meta.env.PUBLIC_CALENDAR_URL || "";
const profiles = ["Integrador", "Indústria", "Comércio", "Hospital ou instituição", "Condomínio", "Posto de combustível", "Outro"];
const challenges = [
  "Parecer de acesso ou inversão de fluxo",
  "Projeto fotovoltaico",
  "Subestação ou média tensão",
  "Aumento de carga",
  "Gerador e continuidade operacional",
  "Hub de recarga",
  "Análise de fatura",
  "Outro",
];
const deadlines = ["Até 7 dias", "Até 30 dias", "Em planejamento"];
---

<form
  class="rounded-md border border-slate-200 bg-white p-6 shadow-crisp sm:p-8"
  data-contact-form
  data-endpoint={endpoint}
  data-turnstile={turnstile}
  data-calendar={calendarUrl}
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <Field id="nome" label="Nome" />
    <Field id="empresa" label="Empresa" />
    <Field id="cargo" label="Cargo" />
    <Field id="email" label="E-mail corporativo" type="email" />
    <Field id="telefone" label="Telefone" placeholder="(11) 99999-9999" />
    <Field id="estado" label="Estado" placeholder="UF" maxlength="2" />
    <Field id="concessionaria" label="Concessionária" />
    <Field id="potencia" label="Potência estimada" placeholder="Ex.: 75 kW, 500 kVA, em estudo" />

    <SelectField id="perfil" label="Perfil de cliente" options={profiles} />
    <SelectField id="desafio" label="Principal desafio" options={challenges} />
    <SelectField id="prazo" label="Prazo" options={deadlines} />

    <label class="hidden" aria-hidden="true">
      Website
      <input name="website" tabindex="-1" autocomplete="off" data-field="website" />
    </label>

    <div class="sm:col-span-2">
      <label for="mensagem" class="block text-sm font-semibold text-slate-800">Mensagem</label>
      <textarea id="mensagem" name="mensagem" rows="5" data-field="mensagem" class="mt-2 w-full resize-none rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-energy-500 focus:ring-4 focus:ring-energy-400/10" placeholder="Inclua contexto técnico, prazo, documentos existentes ou restrição recebida."></textarea>
      <p class="mt-2 hidden text-sm font-medium text-red-600" data-error="mensagem"></p>
    </div>
  </div>

  {turnstile && (
    <div class="mt-5 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
      Turnstile configurado para o endpoint seguro. Renderize o widget no backend ou no fluxo de integração final.
    </div>
  )}

  <div class="mt-6">
    <label class="flex items-start gap-3 text-sm leading-6 text-slate-600" for="lgpd">
      <input id="lgpd" name="lgpd" type="checkbox" data-field="lgpd" class="mt-1 h-4 w-4 rounded border-slate-300 text-energy-600" />
      <span>Autorizo o contato da Kairós Engenharia para retorno sobre esta solicitação e declaro ciência sobre o tratamento dos meus dados para essa finalidade.</span>
    </label>
    <p class="mt-2 hidden text-sm font-medium text-red-600" data-error="lgpd"></p>
  </div>

  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md bg-navy-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-navy-800">
      Enviar solicitação
      <span aria-hidden="true">→</span>
    </button>
    {calendarUrl && (
      <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md border border-slate-200 px-5 py-3 text-sm font-semibold text-navy-950 transition hover:bg-slate-50" data-track="calendar">
        Agendar conversa técnica
      </a>
    )}
  </div>
  <p class="mt-5 hidden rounded-md border border-energy-400/30 bg-energy-400/10 px-4 py-3 text-sm font-medium text-navy-900" role="status" aria-live="polite" data-feedback></p>
</form>

<script>
  // @ts-nocheck
  import { formatPhone, sanitizeText, scoreLead, validateLead } from "../lib/forms";

  function setError(form, field, message) {
    const error = form.querySelector(`[data-error="${field}"]`);
    const input = form.querySelector(`[data-field="${field}"]`);
    if (error) {
      error.textContent = message || "";
      error.classList.toggle("hidden", !message);
    }
    input?.setAttribute("aria-invalid", message ? "true" : "false");
    if (input && message) input.setAttribute("aria-describedby", `${field}-error`);
  }

  function readForm(form) {
    const get = (name) => form.querySelector(`[data-field="${name}"]`);
    return {
      nome: get("nome")?.value || "",
      empresa: get("empresa")?.value || "",
      cargo: get("cargo")?.value || "",
      email: get("email")?.value || "",
      telefone: get("telefone")?.value || "",
      estado: get("estado")?.value || "",
      concessionaria: get("concessionaria")?.value || "",
      perfil: get("perfil")?.value || "",
      desafio: get("desafio")?.value || "",
      potencia: get("potencia")?.value || "",
      prazo: get("prazo")?.value || "",
      mensagem: get("mensagem")?.value || "",
      lgpd: Boolean(get("lgpd")?.checked),
      website: get("website")?.value || "",
    };
  }

  document.querySelectorAll("[data-contact-form]").forEach((form) => {
    const urlParams = new URLSearchParams(window.location.search || sessionStorage.getItem("kairos-triage") || "");
    for (const key of ["perfil", "desafio", "prazo"]) {
      const value = urlParams.get(key);
      const field = form.querySelector(`[data-field="${key}"]`);
      if (value && field) field.value = value;
    }

    form.querySelector('[data-field="telefone"]')?.addEventListener("input", (event) => {
      event.currentTarget.value = formatPhone(event.currentTarget.value);
    });
    form.querySelector('[data-field="estado"]')?.addEventListener("input", (event) => {
      event.currentTarget.value = event.currentTarget.value.toUpperCase().slice(0, 2);
    });
    form.addEventListener("input", () => {
      window.dispatchEvent(new CustomEvent("kairos:analytics", { detail: { name: "form_start" } }));
    }, { once: true });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const feedback = form.querySelector("[data-feedback]");
      feedback?.classList.add("hidden");
      const raw = readForm(form);
      const errors = validateLead(raw);
      for (const field of ["nome", "empresa", "email", "telefone", "estado", "perfil", "desafio", "prazo", "mensagem", "lgpd", "website"]) {
        setError(form, field, errors[field] || "");
      }
      if (Object.keys(errors).length) return;

      const endpoint = form.getAttribute("data-endpoint") || "";
      const payload = {
        ...Object.fromEntries(Object.entries(raw).map(([key, value]) => [key, typeof value === "string" ? sanitizeText(value) : value])),
        leadScore: scoreLead(raw),
        origin: window.location.pathname,
        utm: Object.fromEntries(new URLSearchParams(window.location.search).entries()),
        submittedAt: new Date().toISOString(),
      };

      if (!endpoint) {
        if (feedback) {
          feedback.textContent = "Solicitação validada. Configure o endpoint seguro de envio para concluir a integração.";
          feedback.classList.remove("hidden");
        }
        return;
      }

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error("Falha no endpoint");
        if (feedback) {
          feedback.textContent = "Solicitação enviada com segurança. A equipe retornará pelo contato informado.";
          feedback.classList.remove("hidden");
        }
        form.reset();
        window.dispatchEvent(new CustomEvent("kairos:analytics", { detail: { name: "form_submit", score: payload.leadScore } }));
      } catch {
        if (feedback) {
          feedback.textContent = "Não foi possível concluir o envio. Verifique o endpoint configurado ou tente novamente.";
          feedback.classList.remove("hidden");
        }
      }
    });
  });
</script>
