---
import { withBase } from "@lib/urls";
type Props = {
  title?: string;
  label?: string;
  href?: string;
};
const {
  title = "Antes de investir, valide a engenharia.",
  label = "Solicitar diagnóstico técnico",
  href = "/contato/",
} = Astro.props;
---

<section class="bg-cx-void px-5 pb-24 sm:px-6 lg:px-8">
  <div class="cx-shell">
    <div class="relative isolate overflow-hidden rounded-[1rem] border border-white/10 bg-[linear-gradient(135deg,rgba(14,124,115,.22),rgba(6,19,20,.92)_45%,rgba(201,164,78,.16))] px-6 py-10 text-white shadow-glow sm:px-10">
      <div class="absolute inset-0 bg-hero-grid bg-[size:40px_40px] opacity-30" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="eyebrow text-cx-cyan">Próximo passo</p>
          <h2 class="mt-3 max-w-2xl text-balance text-2xl font-semibold tracking-normal sm:text-3xl">{title}</h2>
        </div>
        <a href={withBase(href)} class="inline-flex w-full items-center justify-center rounded-full bg-cx-gold px-6 py-3 text-sm font-semibold text-cx-void transition hover:-translate-y-0.5 hover:bg-cx-gold-soft sm:w-auto" data-track="cta-final">
          {label} <span class="ml-2" aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </div>
</section>
