---
import { withBase } from "@lib/urls";
type Props = {
  title?: string;
  label?: string;
  href?: string;
};
const {
  title = "Antes de investir, valide a engenharia.",
  label = "Solicitar diagnóstico técnico",
  href = "/contato/",
} = Astro.props;
---

<section class="bg-white px-5 pb-24 sm:px-6 lg:px-8">
  <div class="mx-auto overflow-hidden rounded-md bg-navy-950 px-6 py-10 text-white shadow-glow sm:px-10 lg:max-w-7xl">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-energy-300">Próximo passo</p>
        <h2 class="mt-3 max-w-2xl text-balance text-2xl font-semibold tracking-normal sm:text-3xl">{title}</h2>
      </div>
      <a href={withBase(href)} class="inline-flex w-full items-center justify-center rounded-md bg-energy-400 px-5 py-3 text-sm font-semibold text-navy-950 transition hover:bg-energy-300 sm:w-auto" data-track="cta-final">
        {label} <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
