---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

const linkedin = import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/company/conexium-engenharia";
---

<footer class="relative overflow-hidden border-t border-white/[0.08] bg-[#001F1A] text-[#F7F4EC]/85 font-sans-tech">
  <!-- Marca d'água técnica sutil no fundo do footer (opacidade 2.5%) -->
  <div class="pointer-events-none absolute right-[-40px] bottom-[-40px] opacity-[0.025]" aria-hidden="true">
    <img src={withBase("/brand/conexium-symbol.png")} alt="" class="h-[280px] w-[280px] object-contain" width="280" height="280" />
  </div>

  <div class="cx-shell pt-[52px] pb-[32px] relative z-10">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5 pb-10 border-b border-white/[0.08]">
      <!-- Coluna 1: CONEXIUM & Posicionamento Oficial -->
      <div class="lg:col-span-2 pr-0 lg:pr-8">
        <a href={withBase("/")} aria-label={`${site.name} - Página inicial`}>
          <img src={withBase("/brand/logo-conexium-white.png")} alt={site.name} class="h-8 md:h-9 w-auto object-contain max-w-[210px]" width="210" height="70" />
        </a>
        <p class="mt-4 text-[13px] leading-relaxed text-[#A7ACA8] max-w-[340px]">
          Consultoria técnico-regulatória, engenharia e projetos elétricos, perícias e pareceres técnicos fundamentados em evidências para o setor elétrico.
        </p>
        <p class="mt-4 text-[11px] font-bold tracking-[0.2em] text-[#C79A3B] uppercase">
          ENGENHARIA • REGULAÇÃO • EVIDÊNCIA
        </p>
      </div>

      <!-- Coluna 2: NAVEGAÇÃO -->
      <div>
        <p class="text-[12px] font-bold tracking-[0.16em] text-white uppercase mb-4">Navegação</p>
        <ul class="space-y-2.5 text-[13.5px]">
          {navItems.map((item) => (
            <li>
              <a href={withBase(item.href)} class="text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Coluna 3: SERVIÇOS -->
      <div>
        <p class="text-[12px] font-bold tracking-[0.16em] text-white uppercase mb-4">Serviços</p>
        <ul class="space-y-2.5 text-[13.5px]">
          <li>
            <a href={withBase("/servicos/engenharia-projetos-eletricos/")} class="text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">
              Engenharia e Projetos Elétricos
            </a>
          </li>
          <li>
            <a href={withBase("/servicos/consultoria-tecnico-regulatoria/")} class="text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">
              Consultoria Técnico-Regulatória
            </a>
          </li>
          <li>
            <a href={withBase("/servicos/pericias-pareceres-tecnicos/")} class="text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">
              Perícias e Pareceres Técnicos
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 4: CONTATO -->
      <div>
        <p class="text-[12px] font-bold tracking-[0.16em] text-white uppercase mb-4">Contato</p>
        <div class="space-y-3 text-[13.5px]">
          <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="flex items-center gap-2.5 text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C79A3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>{site.phoneDisplay}</span>
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2.5 text-[#A7ACA8] transition-colors hover:text-[#C79A3B]">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C79A3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <span>{site.email}</span>
          </a>
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 text-[#A7ACA8] transition-colors hover:text-[#C79A3B]" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#C79A3B" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66s-.74-1.66-1.66-1.66-1.66.74-1.66 1.66.74 1.66 1.66 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"></path></svg>
            <span>LinkedIn Oficial</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Linha de direitos e políticas com área legal rigorosa -->
    <div class="pt-6 flex flex-col items-center justify-between gap-4 text-[12px] text-[#A7ACA8] md:flex-row">
      <p>© 2026 Conexium Engenharia. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        <a href={withBase("/politica-de-privacidade/")} class="transition-colors hover:text-[#C79A3B]">Política de Privacidade</a>
        <span class="text-white/20">|</span>
        <a href={withBase("/politica-de-cookies/")} class="transition-colors hover:text-[#C79A3B]">Política de Cookies</a>
      </div>
    </div>
  </div>
</footer>
