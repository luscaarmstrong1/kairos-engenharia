---
import { navItems, servicePages, site } from "@data/site";
import { withBase } from "@lib/urls";
const linkedin = import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/";
---

<footer class="border-t border-white/10 bg-cx-void px-5 py-14 text-cx-text sm:px-6 lg:px-8">
  <div class="cx-shell grid gap-10 lg:grid-cols-[1.2fr_.8fr_.8fr_.8fr]">
    <div>
      <a href={withBase("/")} class="flex items-center gap-3 rounded-md" aria-label={`${site.name} - Página inicial`}>
        <img src={withBase("/brand/conexium-logo-white.svg")} alt={site.name} class="h-10 w-auto max-w-[220px]" width="220" height="40" />
      </a>
      <p class="mt-6 max-w-md text-sm leading-7 text-cx-muted">{site.tagline}</p>
      <p class="mt-4 max-w-md text-xs leading-6 text-cx-muted-2">{site.institutionalNotice}</p>
      <a href={withBase("/contato/")} class="mt-6 inline-flex rounded-full border border-cx-gold/45 px-5 py-3 text-xs font-semibold uppercase text-cx-text transition hover:border-cx-gold hover:bg-cx-gold/10">
        Falar com especialista
      </a>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Navegação</h2>
      <div class="mt-4 grid gap-3">
        {navItems.map((item) => (
          <a href={withBase(item.href)} class="w-fit text-sm text-cx-muted transition hover:text-cx-cyan">{item.label}</a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Soluções</h2>
      <div class="mt-4 grid gap-3">
        {servicePages.map((service) => (
          <a href={withBase(`/servicos/${service.slug}/`)} class="w-fit text-sm text-cx-muted transition hover:text-cx-cyan">{service.title}</a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-white">Contato</h2>
      <div class="mt-4 grid gap-3 text-sm text-cx-muted">
        <a class="w-fit transition hover:text-cx-cyan" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="w-fit transition hover:text-cx-cyan" href={`mailto:${site.directEmail}`}>{site.directEmail}</a>
        <a class="w-fit transition hover:text-cx-cyan" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="w-fit transition hover:text-cx-cyan" href={withBase("/politica-de-privacidade/")}>Privacidade</a>
        <a class="w-fit transition hover:text-cx-cyan" href={withBase("/politica-de-cookies/")}>Cookies</a>
      </div>
    </div>
  </div>
  <div class="cx-shell mt-10 grid gap-4 border-t border-white/10 pt-6 text-xs leading-6 text-cx-muted-2 lg:grid-cols-3">
    <p>© {new Date().getFullYear()} Conexium Engenharia. Todos os direitos reservados.</p>
    <p>{site.technicalNotice}</p>
    <p>{site.forensicNotice}</p>
  </div>
</footer>
