---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

type Props = { currentPath: string };
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
}
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy-950/90 text-white shadow-[0_18px_50px_rgba(0,0,0,.14)] backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8">
    <a href={withBase("/")} class="flex min-w-0 items-center gap-3 rounded-md" aria-label="Kairós Engenharia - Página inicial">
      <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md border border-energy-300/30 bg-white/8 text-sm font-bold tracking-tight text-white shadow-glow">
        K
      </span>
      <span class="min-w-0">
        <strong class="block truncate text-sm tracking-[0.14em] text-white">{site.legalName}</strong>
        <span class="block truncate text-[10px] uppercase tracking-[0.18em] text-slate-400">Engenharia & Energia</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "relative text-sm font-medium transition",
            isActive(item.href) ? "text-white" : "text-slate-300 hover:text-white",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
          <span class:list={["absolute -bottom-2 left-0 h-0.5 rounded-full bg-energy-400 transition-all", isActive(item.href) ? "w-full" : "w-0"]} aria-hidden="true" />
        </a>
      ))}
    </nav>

    <a
      href={withBase("/contato/")}
      class="hidden items-center gap-2 rounded-md bg-energy-400 px-4 py-2.5 text-sm font-semibold text-navy-950 transition hover:bg-energy-300 lg:inline-flex"
      data-track="cta-header"
    >
      Solicitar diagnóstico
      <span aria-hidden="true">→</span>
    </a>

    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-md border border-white/15 bg-white/5 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
      data-menu-button
    >
      <span data-menu-icon-open aria-hidden="true">☰</span>
      <span data-menu-icon-close class="hidden" aria-hidden="true">×</span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-navy-950 px-5 pb-5 pt-3 lg:hidden" aria-label="Navegação móvel" data-mobile-menu>
    <div class="mx-auto flex max-w-7xl flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "rounded-md px-3 py-3 text-sm font-medium transition",
            isActive(item.href) ? "bg-energy-400 text-navy-950" : "text-slate-200 hover:bg-white/8",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // @ts-nocheck
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-icon-open]");
  const closeIcon = document.querySelector("[data-menu-icon-close]");
  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    button.setAttribute("aria-label", isOpen ? "Abrir menu" : "Fechar menu");
    menu?.classList.toggle("hidden", isOpen);
    openIcon?.classList.toggle("hidden", !isOpen);
    closeIcon?.classList.toggle("hidden", isOpen);
  });
</script>
