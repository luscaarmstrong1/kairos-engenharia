---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

type Props = { currentPath: string };
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
}
---

<header class="sticky inset-x-0 top-0 z-50 border-b border-white/10 bg-[#061314]/75 text-white backdrop-blur-xl transition-colors" data-site-header>
  <div class="cx-shell flex h-20 items-center justify-between">
    <a href={withBase("/")} class="flex min-w-0 items-center gap-3 rounded-md" aria-label={`${site.name} - Página inicial`}>
      <img src={withBase("/brand/conexium-logo-white.svg")} alt={site.name} class="h-10 w-auto max-w-[210px] shrink-0" width="210" height="40" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegação principal">
      {navItems.filter((item) => item.href !== "/a-conexium/").map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "relative text-xs font-medium uppercase tracking-[0.16em] transition-colors",
            isActive(item.href) ? "text-cx-cyan" : "text-white/60 hover:text-cx-cyan",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
          <span class:list={["absolute -bottom-2 left-0 h-px rounded-full bg-cx-cyan transition-all", isActive(item.href) ? "w-full" : "w-0"]} aria-hidden="true" />
        </a>
      ))}
    </nav>

    <a
      href={withBase("/contato/")}
      class="hidden rounded-full border border-cx-gold/50 px-5 py-3 text-xs font-medium uppercase tracking-[0.14em] text-cx-text transition hover:border-[#e0c16d] hover:bg-cx-gold/10 lg:inline-flex"
      data-track="cta-header"
    >
      Solicitar diagnóstico
    </a>

    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-full border border-white/15 bg-white/5 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
      data-menu-button
    >
      <span class="h-4 w-5 border-y border-white/80" data-menu-icon-open aria-hidden="true"></span>
      <span class="hidden text-2xl leading-none text-white" data-menu-icon-close aria-hidden="true">&times;</span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-[#061314]/98 px-4 pb-5 pt-3 shadow-glow lg:hidden" aria-label="Navegação móvel" data-mobile-menu>
    <div class="mx-auto flex w-[min(100%-1rem,1200px)] flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "rounded-md px-3 py-3 text-sm font-medium transition",
            isActive(item.href) ? "bg-cx-cyan text-cx-void" : "text-white/72 hover:bg-white/8 hover:text-white",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={withBase("/contato/")} class="mt-2 rounded-full border border-cx-gold/50 px-4 py-3 text-center text-xs font-semibold uppercase tracking-[0.14em] text-cx-text">
        Solicitar diagnóstico
      </a>
    </div>
  </nav>
</header>

<script>
  // @ts-nocheck
  const header = document.querySelector("[data-site-header]");
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-icon-open]");
  const closeIcon = document.querySelector("[data-menu-icon-close]");
  function setMenu(open) {
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu?.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }
  button?.addEventListener("click", () => setMenu(button.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
  document.addEventListener("click", (event) => {
    if (button?.getAttribute("aria-expanded") === "true" && header && !header.contains(event.target)) setMenu(false);
  });
</script>
