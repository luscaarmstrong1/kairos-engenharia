---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
};

const { eyebrow, title, description, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-white/10 bg-cx-void px-5 pb-20 pt-36 text-cx-text sm:px-6 lg:px-8">
  <div class="absolute inset-0 bg-hero-grid bg-[size:44px_44px] opacity-55" aria-hidden="true"></div>
  <div class="absolute left-1/2 top-0 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-cx-teal/20 blur-3xl" aria-hidden="true"></div>
  <div class="absolute right-0 top-16 h-72 w-72 rounded-full bg-cx-gold/10 blur-3xl" aria-hidden="true"></div>
  <div class="noise"></div>
  <div class="relative mx-auto max-w-7xl">
    <p class="eyebrow text-cx-cyan">{eyebrow}</p>
    <h1 class="h-display mt-6 max-w-5xl text-balance">{title}</h1>
    <p class="text-lead mt-6 max-w-3xl">{description}</p>
    {(primaryHref || secondaryHref) && (
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        {primaryHref && primaryLabel && (
          <a href={primaryHref} class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-cx-gold px-6 py-3 text-sm font-semibold text-cx-void shadow-glow transition hover:-translate-y-0.5 hover:bg-cx-gold-soft" data-track="hero-primary">
            <span class="absolute inset-y-0 -left-1/2 w-1/2 -skew-x-12 bg-white/35 opacity-0 transition group-hover:animate-[cxShine_1s_ease]" aria-hidden="true"></span>
            <span class="relative">{primaryLabel}</span>
            <span class="relative ml-2" aria-hidden="true">-&gt;</span>
          </a>
        )}
        {secondaryHref && secondaryLabel && (
          <a href={secondaryHref} class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/6 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-cx-cyan/60 hover:bg-white/10" data-track="hero-secondary">
            {secondaryLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>
