---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
  dark?: boolean;
};
const { eyebrow, title, description, dark = false } = Astro.props;
---

<div class="reveal max-w-3xl">
  <p class:list={["text-sm font-bold uppercase tracking-[0.18em]", dark ? "text-energy-300" : "text-energy-600"]}>{eyebrow}</p>
  <h2 class:list={["mt-4 text-balance text-3xl font-semibold tracking-normal sm:text-4xl", dark ? "text-white" : "text-slate-950"]}>{title}</h2>
  {description && <p class:list={["mt-5 text-base leading-8", dark ? "text-slate-300" : "text-slate-600"]}>{description}</p>}
</div>
