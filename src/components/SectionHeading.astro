---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
  dark?: boolean;
};
const { eyebrow, title, description, dark = false } = Astro.props;
---

<div class="reveal max-w-3xl">
  <p class:list={["eyebrow", dark ? "text-cx-cyan" : "text-cx-teal"]}>{eyebrow}</p>
  <h2 class:list={["h-section mt-4 text-balance", dark ? "text-cx-text" : "text-slate-950"]}>{title}</h2>
  {description && <p class:list={["mt-5 text-base leading-8", dark ? "text-cx-muted" : "text-slate-600"]}>{description}</p>}
</div>
