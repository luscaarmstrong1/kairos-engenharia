---
type Props = {
  id: string;
  label: string;
  options: string[];
};

const { id, label, options } = Astro.props;
---

<div>
  <label for={id} class="block text-sm font-semibold text-slate-800">{label}</label>
  <select
    id={id}
    name={id}
    data-field={id}
    class="mt-2 w-full rounded-md border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-cx-teal focus:ring-4 focus:ring-cx-teal/10"
  >
    <option value="">Selecione</option>
    {options.map((option) => <option value={option}>{option}</option>)}
  </select>
  <p class="mt-2 hidden text-sm font-medium text-red-600" id={`${id}-error`} data-error={id}></p>
</div>
