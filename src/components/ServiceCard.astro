---
import { withBase } from "@lib/urls";
type Props = {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
};
const { title, description, href, eyebrow = "Solução" } = Astro.props;
---

<article class="cx-card reveal flex h-full flex-col p-7">
  <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-md border border-cx-cyan/25 bg-cx-cyan/10 text-cx-cyan" aria-hidden="true">
    <span class="h-2.5 w-2.5 rounded-full bg-current shadow-[0_0_18px_rgba(88,224,212,.75)]"></span>
  </div>
  <p class="eyebrow text-cx-gold">{eyebrow}</p>
  <h3 class="mt-4 text-2xl font-semibold tracking-normal text-cx-text">{title}</h3>
  <p class="mt-4 text-sm leading-7 text-cx-muted">{description}</p>
  <a href={withBase(href)} class="mt-auto inline-flex items-center pt-6 text-sm font-semibold text-cx-cyan transition hover:text-white">
    Ver detalhes <span class="ml-2" aria-hidden="true">-&gt;</span>
  </a>
</article>
