---
import { withBase } from "@lib/urls";
type Props = {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
};
const { title, description, href, eyebrow = "Solução" } = Astro.props;
---

<article class="reveal rounded-md border border-slate-200 bg-white p-7 shadow-crisp">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-energy-600">{eyebrow}</p>
  <h3 class="mt-4 text-2xl font-semibold tracking-normal text-slate-950">{title}</h3>
  <p class="mt-4 text-sm leading-7 text-slate-600">{description}</p>
  <a href={withBase(href)} class="mt-6 inline-flex items-center text-sm font-semibold text-energy-700">
    Ver detalhes <span class="ml-2" aria-hidden="true">→</span>
  </a>
</article>
