---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FloatingActions from "@components/FloatingActions.astro";
import CookieConsent from "@components/CookieConsent.astro";
import { site } from "@data/site";
import { absoluteUrl, withBase } from "@lib/urls";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  path?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description = site.defaultDescription,
  path = Astro.url.pathname.replace("/kairos-engenharia", "") || "/",
  ogType = "website",
  jsonLd,
} = Astro.props;

const canonical = absoluteUrl(path);
const fontUrl = withBase("/fonts/inter-latin.woff2");
const faviconUrl = absoluteUrl("/favicon.svg");
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  email: site.email,
};
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  serviceType: [
    "Engenharia elétrica",
    "Consultoria técnico-regulatória",
    "Perícias técnicas",
    "Elaboração de quesitos",
    "Projetos elétricos",
    "Inteligência energética",
    "Eletromobilidade",
  ],
  areaServed: "Brasil",
};
const jsonPayload = [organizationJsonLd, serviceJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests;"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061525" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={faviconUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <title>{pageTitle}</title>
    <style is:inline set:html={`@font-face{font-family:"Inter";font-style:normal;font-weight:400 800;font-display:swap;src:url("${fontUrl}") format("woff2");}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonPayload)} />
  </head>
  <body class="bg-white text-slate-900">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-md focus:bg-energy-400 focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-navy-950">
      Pular para o conteúdo
    </a>
    <Header currentPath={path} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <FloatingActions pathname={path} />
    <CookieConsent />
    <script>
      // @ts-nocheck
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) entry.target.classList.add("is-visible");
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal").forEach((node) => revealObserver.observe(node));
    </script>
  </body>
</html>
