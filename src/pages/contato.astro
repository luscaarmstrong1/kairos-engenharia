---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { site } from "@data/site";
---

<BaseLayout
  title="Contato | Conexium Engenharia"
  description="Entre em contato com a Conexium Engenharia para solicitar uma avaliação técnica especializada em engenharia elétrica, regulação ou perícias."
  path="/contato/"
>
  <!-- Hero Section Contato -->
  <section class="relative isolate overflow-hidden border-b border-white/[0.08] bg-[#001F1A] py-16 lg:py-20 text-white font-sans-tech">
    <div class="pointer-events-none absolute inset-0 tech-grid-pattern opacity-50" aria-hidden="true"></div>

    <div class="cx-shell relative z-10">
      <div class="flex items-center gap-2 mb-3.5">
        <span class="inline-block h-[1px] w-4 bg-[#C79A3B]" aria-hidden="true"></span>
        <p class="text-[11px] sm:text-[12px] font-semibold tracking-[0.2em] text-[#C79A3B] uppercase">
          CANAIS DE ATENDIMENTO
        </p>
      </div>
      <h1 class="font-serif-display text-[clamp(2.2rem,3.4vw,3.2rem)] text-white leading-tight">
        Fale com um especialista
      </h1>
      <p class="mt-4 max-w-xl text-[14.5px] leading-relaxed text-[#F7F4EC]/80">
        Apresente sua demanda para avaliação técnica. Atendemos empresas, integradores, investidores, escritórios e agentes do setor elétrico.
      </p>
    </div>
  </section>

  <!-- Form and Direct Channels -->
  <section class="bg-[#F7F4EC] py-20 text-[#18211F] font-sans-tech">
    <div class="cx-shell">
      <div class="grid gap-12 lg:grid-cols-[40%_60%]">
        <!-- Direct Channels -->
        <div>
          <h2 class="font-serif-display text-2xl text-[#001F1A]">
            Canais Diretos
          </h2>
          <p class="mt-3 text-[13px] leading-relaxed text-[#18211F]/75">
            Nossa equipe técnica analisa solicitações com rigor técnico e sigilo profissional.
          </p>

          <div class="mt-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded border border-[#18211F]/15 bg-white text-[#C79A3B]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-[#A7ACA8]">Telefone / WhatsApp</p>
                <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="mt-1 block text-sm font-semibold text-[#001F1A] transition hover:text-[#C79A3B]">
                  {site.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded border border-[#18211F]/15 bg-white text-[#C79A3B]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-[#A7ACA8]">E-mail Corporativo</p>
                <a href={`mailto:${site.email}`} class="mt-1 block text-sm font-semibold text-[#001F1A] transition hover:text-[#C79A3B]">
                  {site.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded border border-[#18211F]/15 bg-white text-[#C79A3B]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              </div>
              <div>
                <p class="text-[11px] font-bold uppercase tracking-wider text-[#A7ACA8]">Responsabilidade Técnica</p>
                <p class="mt-1 text-[13px] text-[#18211F]/75">
                  Atendimento especializado com emissão de ART conforme o escopo contratado.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Component -->
        <div>
          <ContactForm />
        </div>
      </div>

      <!-- Orientação: Como funciona o atendimento -->
      <div class="mt-20 border-t border-[#18211F]/15 pt-16">
        <div class="text-center max-w-2xl mx-auto">
          <p class="text-[11px] font-bold tracking-[0.16em] text-[#C79A3B] uppercase">
            FLUXO TRANSPARENTE
          </p>
          <h2 class="font-serif-display mt-2 text-2xl sm:text-3xl text-[#001F1A]">
            Como funciona o atendimento
          </h2>
          <p class="mt-2 text-[14px] text-[#18211F]/70">
            Processo estruturado para avaliar sua demanda técnica com segurança e agilidade.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="rounded-[8px] border border-[#18211F]/10 bg-white p-6 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-[#C79A3B] text-xs font-bold text-[#C79A3B]">
              01
            </span>
            <h3 class="font-serif-display mt-4 text-lg font-bold text-[#001F1A]">
              Apresente sua demanda
            </h3>
            <p class="mt-2 text-[13px] leading-relaxed text-[#18211F]/75">
              Informe resumidamente o contexto, os objetivos do projeto, a controvérsia regulatória ou a perícia necessária.
            </p>
          </div>

          <div class="rounded-[8px] border border-[#18211F]/10 bg-white p-6 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-[#C79A3B] text-xs font-bold text-[#C79A3B]">
              02
            </span>
            <h3 class="font-serif-display mt-4 text-lg font-bold text-[#001F1A]">
              Avaliação inicial
            </h3>
            <p class="mt-2 text-[13px] leading-relaxed text-[#18211F]/75">
              Nossa equipe técnica verifica as informações preliminares, a documentação disponível e a natureza do caso.
            </p>
          </div>

          <div class="rounded-[8px] border border-[#18211F]/10 bg-white p-6 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-[#C79A3B] text-xs font-bold text-[#C79A3B]">
              03
            </span>
            <h3 class="font-serif-display mt-4 text-lg font-bold text-[#001F1A]">
              Definição do encaminhamento
            </h3>
            <p class="mt-2 text-[13px] leading-relaxed text-[#18211F]/75">
              Quando aplicável, definem-se o escopo técnico exato, os entregáveis formais com ART e o cronograma dos próximos passos.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
