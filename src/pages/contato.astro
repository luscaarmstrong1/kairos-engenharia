---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import ContactForm from "@components/ContactForm.astro";
---

<BaseLayout
  title="Contato"
  description="Envie seu contexto técnico para triagem inicial da Conexium Engenharia."
  path="/contato/"
>
  <PageHero
    eyebrow="Contato"
    title="Seu projeto precisa de engenharia que trate risco como variável de decisão."
    description="O formulário organiza perfil, tipo de demanda, prazo e contexto técnico. A confirmação real depende de endpoint seguro configurado."
  />

  <section class="bg-[#f6f8f7] px-5 py-24 text-slate-950 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow text-cx-teal">Diagnóstico técnico</p>
        <h2 class="h-section mt-4 text-balance">Quanto melhor o contexto, mais objetiva é a primeira leitura técnica.</h2>
        <p class="mt-5 text-base leading-8 text-slate-600">Não inclua senhas, chaves, dados sensíveis desnecessários ou documentos confidenciais antes de um canal seguro ser combinado.</p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
