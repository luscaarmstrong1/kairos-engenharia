---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { absoluteUrl, withBase } from "@lib/urls";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => post.data.status === "published");
  return posts.map((post) => ({
    params: { slug: post.data.slug.replace(/^\/conteudos\//, "").replace(/\/$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = post.data.slug;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate || post.data.date).toISOString(),
  author: { "@type": "Organization", name: "Conexium Engenharia" },
  mainEntityOfPage: absoluteUrl(path),
};
---

<BaseLayout
  title={`${post.data.title} | Conexium Engenharia`}
  description={post.data.description}
  path={path}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <!-- Hero Section Editorial do Artigo -->
  <section class="border-b border-white/[0.08] bg-[#001F1A] py-16 text-white font-sans-tech">
    <div class="cx-shell max-w-4xl">
      <nav class="flex items-center gap-2 text-xs text-[#A7ACA8]" aria-label="Breadcrumb">
        <a href={withBase("/")} class="hover:text-[#C79A3B]">Início</a>
        <span>/</span>
        <a href={withBase("/conteudos/")} class="hover:text-[#C79A3B]">Casos e Insights</a>
        <span>/</span>
        <span class="text-[#F7F4EC] truncate max-w-[240px] sm:max-w-none">{post.data.category}</span>
      </nav>

      <div class="mt-6 flex items-center gap-3">
        <span class="rounded bg-[#042923] border border-[#C79A3B]/30 px-2.5 py-1 text-[11px] font-semibold text-[#C79A3B]">
          {post.data.category}
        </span>
        <span class="text-xs text-[#A7ACA8]">{post.data.readingTime} de leitura</span>
        <span class="text-xs text-[#A7ACA8]">·</span>
        <span class="text-xs text-[#A7ACA8]">Autoria: Equipe Técnica Conexium</span>
      </div>

      <h1 class="font-serif-display mt-4 text-[clamp(2.2rem,3.4vw,3.2rem)] text-white leading-tight">
        {post.data.title}
      </h1>
      <p class="mt-4 text-base text-[#F7F4EC]/85 leading-relaxed max-w-3xl">
        {post.data.description}
      </p>
    </div>
  </section>

  <!-- Conteúdo do Artigo -->
  <article class="bg-[#F7F4EC] py-20 text-[#18211F] font-sans-tech">
    <div class="cx-shell max-w-3xl prose prose-slate">
      <Content />
    </div>
  </article>

  <!-- CTA pós-leitura com encaminhamento para Serviços e Contato -->
  <section class="border-t border-white/[0.08] bg-[#042923] py-16 text-white text-center font-sans-tech">
    <div class="cx-shell max-w-2xl">
      <h2 class="font-serif-display text-2xl text-white">
        Precisa aprofundar este tema no seu caso concreto?
      </h2>
      <p class="mt-3 text-[14.5px] text-[#A7ACA8]">
        A equipe de engenharia da Conexium está à disposição para analisar documentos, avaliar conformidade normativa e emitir manifestações técnicas.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href={withBase("/contato/")} class="btn-gold">
          Solicitar avaliação técnica →
        </a>
        <a href={withBase("/servicos/")} class="btn-secondary-dark">
          Conhecer soluções
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
