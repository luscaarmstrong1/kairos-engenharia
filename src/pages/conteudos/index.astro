---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { withBase } from "@lib/urls";

const posts = (await getCollection("blog")).filter((post) => post.data.status === "published").sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryOrder = [
  "Regulação",
  "Engenharia elétrica",
  "Inteligência energética",
  "Eletromobilidade",
  "Projetos e infraestrutura",
  "Geração distribuída",
];
const categories = categoryOrder.filter((category) => posts.some((post) => post.data.category === category));
---

<BaseLayout
  title="Conteúdos técnicos"
  description="Artigos técnicos sobre engenharia elétrica, conexão à rede, geração distribuída, regulação, perícias, inteligência energética, eletromobilidade e infraestrutura elétrica."
  path="/conteudos/"
>
  <PageHero
    eyebrow="Conteúdos"
    title="Conteúdos técnicos"
    description="Artigos, roteiros e análises técnicas sobre engenharia elétrica, conexão à rede, geração distribuída, regulação, perícias, inteligência energética, infraestrutura e novas cargas."
  />

  <section class="bg-white px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div class="reveal max-w-3xl space-y-5 text-base leading-8 text-slate-600">
          <p>
            A área de conteúdos da Conexium Engenharia reúne materiais técnicos elaborados para apoiar empresas, integradores, consumidores, assistentes técnicos e profissionais que precisam tomar decisões em temas de energia elétrica.
          </p>
          <p>
            Os artigos são produzidos com foco em clareza, rastreabilidade e aplicação prática. Sempre que o assunto envolver interpretação regulatória, normas técnicas, pareceres de distribuidoras ou decisões administrativas, o conteúdo deve passar por revisão humana antes da publicação.
          </p>
          <p>
            Os materiais têm caráter informativo e técnico. Eles não substituem análise individual do caso concreto, projeto elétrico específico, parecer técnico formal ou orientação jurídica quando aplicável.
          </p>
        </div>
        <aside class="reveal rounded-md border border-energy-400/30 bg-energy-400/10 p-6 text-sm leading-7 text-slate-700">
          <h2 class="text-base font-semibold tracking-normal text-slate-950">Conteúdo técnico com revisão humana antes de qualquer publicação regulatória.</h2>
          <p class="mt-4">
            Os artigos iniciais são estáticos, estruturados em Markdown e evitam tratar premissas regulatórias, técnicas ou jurídicas como verdades absolutas quando dependem do caso concreto, da distribuidora, da documentação disponível ou da norma aplicável.
          </p>
        </aside>
      </div>

      <div class="reveal mt-12 flex flex-wrap gap-2" aria-label="Categorias de conteúdo">
        <button type="button" class="rounded-full border border-navy-950 bg-navy-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-800" data-category-filter="all">Todos</button>
        {categories.map((category) => (
          <button type="button" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-energy-500 hover:text-energy-700" data-category-filter={category}>
            {category}
          </button>
        ))}
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-3" data-article-grid>
        {posts.map((post) => (
          <article class="reveal flex min-h-[360px] flex-col rounded-md border border-slate-200 bg-white p-7 shadow-crisp transition duration-200 hover:-translate-y-1 hover:border-energy-500/70 hover:shadow-glow" data-category-card={post.data.category}>
            <div class="flex items-center justify-between gap-4">
              <span class="rounded-full bg-energy-400/12 px-3 py-1 text-xs font-bold text-energy-700">{post.data.category}</span>
              <span class="shrink-0 text-xs font-medium text-slate-500">{post.data.readingTime}</span>
            </div>
            <h2 class="mt-6 text-xl font-semibold tracking-normal text-slate-950">{post.data.title}</h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">{post.data.summary}</p>
            <p class="mt-3 flex-1 text-sm leading-7 text-slate-500">{post.data.complement}</p>
            <a href={withBase(post.data.slug)} class="mt-6 inline-flex w-fit items-center text-sm font-semibold text-energy-700 transition hover:text-energy-800" data-track="article-read">
              Ler artigo <span class="ml-2" aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <p class="mt-10 hidden rounded-md border border-slate-200 bg-slate-50 px-5 py-4 text-sm text-slate-600" data-empty-state>
        Nenhum conteúdo encontrado para esta categoria.
      </p>
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll("[data-category-filter]");
    const articleCards = document.querySelectorAll("[data-category-card]");
    const emptyState = document.querySelector("[data-empty-state]");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selectedCategory = button.getAttribute("data-category-filter");
        let visibleCards = 0;

        filterButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("border-navy-950", isActive);
          item.classList.toggle("bg-navy-950", isActive);
          item.classList.toggle("text-white", isActive);
          item.classList.toggle("border-slate-200", !isActive);
          item.classList.toggle("bg-white", !isActive);
          item.classList.toggle("text-slate-700", !isActive);
        });

        articleCards.forEach((card) => {
          const isVisible = selectedCategory === "all" || card.getAttribute("data-category-card") === selectedCategory;
          card.classList.toggle("hidden", !isVisible);
          if (isVisible) visibleCards += 1;
        });

        emptyState?.classList.toggle("hidden", visibleCards > 0);
      });
    });
  </script>
</BaseLayout>
