---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@lib/urls";

const allPosts = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts[0];
const regularPosts = allPosts.slice(1);

const categories = [
  "Todos",
  "Engenharia Elétrica",
  "Regulação",
  "Perícias e Pareceres",
];
---

<BaseLayout
  title="Casos e Insights | Conexium Engenharia"
  description="Conhecimento técnico aplicado à engenharia elétrica, regulação setorial e decisões estratégicas no setor elétrico."
  path="/conteudos/"
>
  <!-- Hero Section Editorial -->
  <section class="relative isolate overflow-hidden border-b border-white/[0.08] bg-[#001F1A] py-20 text-white font-sans-tech">
    <div class="pointer-events-none absolute inset-0 tech-grid-pattern opacity-50" aria-hidden="true"></div>

    <div class="cx-shell relative z-10">
      <div class="flex items-center gap-2 mb-3.5">
        <span class="inline-block h-[1px] w-4 bg-[#C79A3B]" aria-hidden="true"></span>
        <p class="text-[11px] sm:text-[12px] font-semibold tracking-[0.2em] text-[#C79A3B] uppercase">
          CENTRAL DE CONHECIMENTO TÉCNICO
        </p>
      </div>
      <h1 class="font-serif-display text-[clamp(2.4rem,3.8vw,3.8rem)] text-white leading-tight">
        Casos e Insights
      </h1>
      <p class="mt-4 max-w-2xl text-[15.5px] sm:text-[16.5px] text-[#F7F4EC]/85 leading-relaxed">
        Conhecimento técnico aplicado à engenharia, regulação e decisões no setor elétrico.
      </p>

      <!-- Categorias Pills -->
      <div class="mt-8 flex flex-wrap gap-2 text-xs">
        {categories.map((cat, idx) => (
          <span class={`rounded-full px-3.5 py-1.5 font-medium border transition ${
            idx === 0
              ? "border-[#C79A3B] bg-[#C79A3B]/15 text-[#C79A3B]"
              : "border-white/[0.12] bg-[#042923] text-[#A7ACA8]"
          }`}>
            {cat}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Corpo Editorial: Artigo em Destaque + Grid Estruturado -->
  <section class="bg-[#F7F4EC] py-20 text-[#18211F] font-sans-tech">
    <div class="cx-shell">
      {featuredPost && (
        <div class="mb-14">
          <p class="text-[11px] font-bold tracking-widest text-[#C79A3B] uppercase mb-4">
            Artigo em Destaque
          </p>
          <article class="grid lg:grid-cols-[55%_45%] gap-8 rounded-[8px] border border-[#18211F]/15 bg-white p-8 sm:p-10 shadow-sm transition hover:border-[#C79A3B]/50 hover:shadow-md">
            <div class="flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3">
                  <span class="rounded bg-[#001F1A] px-2.5 py-1 text-[11px] font-semibold text-[#C79A3B]">
                    {featuredPost.data.category}
                  </span>
                  <span class="text-xs text-[#18211F]/60">{featuredPost.data.readingTime} de leitura</span>
                </div>
                <h2 class="font-serif-display mt-4 text-2xl sm:text-3xl text-[#001F1A] leading-snug">
                  {featuredPost.data.title}
                </h2>
                <p class="mt-3 text-[14px] leading-relaxed text-[#18211F]/75">
                  {featuredPost.data.summary}
                </p>
              </div>

              <div class="mt-8 pt-6 border-t border-[#18211F]/10">
                <a href={withBase(featuredPost.data.slug)} class="btn-gold inline-flex items-center">
                  Ler artigo técnico <span class="ml-2" aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <div class="rounded-[6px] border border-[#18211F]/10 bg-[#042923] p-8 text-white flex flex-col justify-center">
              <p class="text-[11px] font-bold tracking-wider text-[#C79A3B] uppercase">Síntese Prática</p>
              <p class="mt-3 text-[13.5px] text-[#F7F4EC]/85 leading-relaxed">
                {featuredPost.data.complement || featuredPost.data.description}
              </p>
              <div class="mt-6 flex items-center gap-2 text-xs text-[#A7ACA8]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#C79A3B]"></span>
                <span>Publicado para subsídio a decisões no setor elétrico</span>
              </div>
            </div>
          </article>
        </div>
      )}

      <!-- Grade dos demais artigos -->
      <div>
        <p class="text-[11px] font-bold tracking-widest text-[#C79A3B] uppercase mb-6">
          Publicações Técnicas Recentes
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {regularPosts.map((post) => (
            <article class="flex flex-col rounded-[8px] border border-[#18211F]/15 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-[#C79A3B]/60 hover:shadow-md">
              <div class="flex items-center justify-between gap-4">
                <span class="rounded bg-[#001F1A] px-2.5 py-1 text-[11px] font-semibold text-[#C79A3B]">
                  {post.data.category}
                </span>
                <span class="text-xs text-[#18211F]/60">{post.data.readingTime}</span>
              </div>

              <h2 class="font-serif-display mt-5 text-xl font-bold text-[#001F1A] leading-snug">
                {post.data.title}
              </h2>

              <p class="mt-3 flex-1 text-[13px] leading-relaxed text-[#18211F]/75">
                {post.data.summary}
              </p>

              <div class="mt-6 pt-4 border-t border-[#18211F]/10">
                <a href={withBase(post.data.slug)} class="inline-flex items-center text-xs font-bold text-[#001F1A] hover:text-[#C79A3B]">
                  Ler artigo técnico <span class="ml-1.5" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA de Fechamento -->
  <section class="border-t border-white/[0.08] bg-[#001F1A] py-16 text-white text-center font-sans-tech">
    <div class="cx-shell max-w-2xl">
      <h2 class="font-serif-display text-2xl sm:text-3xl text-white">
        Dúvidas sobre o enquadramento do seu caso?
      </h2>
      <p class="mt-3 text-[14.5px] text-[#A7ACA8]">
        Nossa equipe de engenheiros está disponível para avaliar documentos técnicos e regulatórios com rigor e confidencialidade.
      </p>
      <div class="mt-6">
        <a href={withBase("/contato/")} class="btn-gold">
          Solicitar diagnóstico técnico →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
