    tags: ["Geradores", "QTA", "Operação crítica"],
    href: "/servicos/engenharia-projetos-eletricos/",
  },
  {
    title: "Automação técnica e gestão documental",
    description: "Planilhas inteligentes, Python, VBA, dashboards, documentos, formulários, protocolos e evidências.",
    tags: ["Python", "VBA", "Dashboards"],
    href: "/servicos/inteligencia-energetica/",
  },
];

const methodSteps = [
  { title: "Diagnóstico técnico", text: "Leitura do problema, documentos, restrições e objetivo." },
  { title: "Organização de evidências", text: "Estruturação de dados, faturas, projetos, medições e normas." },
  { title: "Estratégia técnica", text: "Cenários, riscos, alternativas, quesitos e premissas." },
  { title: "Entrega rastreável", text: "Relatório, parecer, memorial, matriz ou documentação técnica." },
];

const forensicCards = [
  {
    title: "Elaboração de quesitos técnicos",
    text: "Perguntas objetivas para temas de energia, GD, danos, consumo, demanda e instalações.",
  },
  {
    title: "Análise de laudos e pareceres",
    text: "Leitura técnica de laudos, medições, faturas, projetos, fotos e diagramas.",
  },
  {
    title: "Assistência técnica e evidências",
    text: "Matriz de evidências, linha do tempo, normas, cálculos e subsídios técnicos.",
  },
];

const integratorChecks = [
  "Revisão de documentação antes de protocolo",
  "Análise de exigências e restrições da distribuidora",
  "Alternativas técnicas para conexão, carga e geração",
  "Padronização de evidências para reduzir retrabalho",
];

const showcaseFilters = ["Todos", "Conexão", "Regulação", "Perícias", "Projetos", "Dados", "Eletromobilidade", "Integradores"];

const showcaseSuggestions = [
  "Parecer de acesso",
  "Inversão de fluxo",
  "Quesitos técnicos",
  "Análise de faturas",
  "Projeto BT/MT",
  "Hub de recarga",
  "Aumento de carga",
];

const showcaseSolutions = [
  {
    title: "Parecer de Acesso Auditável",
    description:
      "Transforme respostas de distribuidoras em uma análise técnica clara, rastreável e fundamentada.",
    tags: ["Conexão", "Blueprint", "Integradores"],
    category: "Conexão",
    href: "/servicos/consultoria-regulatoria/",
    cta: "Explorar análise",
    variant: "access",
    featured: true,
  },
  {
    title: "Projetos BT/MT e Infraestrutura",
    description:
      "Projetos elétricos estruturados para segurança, aprovação, operação e expansão futura.",
    tags: ["Projetos", "Corporate", "BT/MT"],
    category: "Projetos",
    href: "/servicos/engenharia-projetos-eletricos/",
    cta: "Ver projetos",
    variant: "project",
  },
  {
    title: "Perícias, Quesitos e Evidências",
    description:
      "Organize laudos, fotos, faturas e medições em perguntas técnicas objetivas e verificáveis.",
    tags: ["Perícias", "Documental", "Quesitos"],
    category: "Perícias",
    href: "/servicos/pericias-quesitos-pareceres/",
    cta: "Ver escopo",
    variant: "forensics",
  },
  {
    title: "Inteligência Energética",
    description:
      "Faturas, demanda, consumo e indicadores convertidos em leitura técnica para decisão.",
    tags: ["Dados", "Dashboard", "Faturas"],
    category: "Dados",
    href: "/servicos/inteligencia-energetica/",
    cta: "Analisar dados",
    variant: "data",
  },
  {
    title: "Eletromobilidade e Novas Cargas",
    description:
      "Antes dos carregadores, dimensione demanda, proteção, entrada de energia e capacidade da rede.",
    tags: ["Recarga", "Infraestrutura", "Novas cargas"],
    category: "Eletromobilidade",
    href: "/servicos/eletromobilidade/",
    cta: "Avaliar viabilidade",
    variant: "mobility",
  },
  {
    title: "Retaguarda para Integradores",
    description:
      "Suporte técnico para reduzir retrabalho, responder exigências e fortalecer entregas de integradores.",
    tags: ["Integradores", "Bento", "White label"],
    category: "Integradores",
    href: "/para-integradores/",
    cta: "Solicitar apoio",
