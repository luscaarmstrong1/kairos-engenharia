const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://conexiumengenharia.com.br/" },
  ],
};
---

<BaseLayout
  title="Conexium Engenharia | Engenharia, conexão e inteligência técnica"
  description="Engenharia elétrica, conexão à rede, geração distribuída, regulação, perícias técnicas, quesitos, inteligência energética e eletromobilidade para empresas e integradores."
  path="/"
  jsonLd={breadcrumbJsonLd}
>
  <section class="home-hero-showcase relative isolate min-h-screen overflow-hidden border-b border-white/10 px-4 pb-16 pt-28 text-cx-text sm:pt-32 lg:pt-36">
    <div class="noise"></div>
    <div class="relative z-10 mx-auto max-w-5xl text-center">
      <div class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 backdrop-blur-xl">
        <span class="h-2 w-2 rounded-full bg-cx-cyan shadow-[0_0_18px_rgba(88,224,212,.75)]" aria-hidden="true"></span>
        <span class="text-[0.68rem] font-semibold uppercase leading-5 tracking-[0.18em] text-white/65">
          Conexão à rede · Regulação · Perícias · Inteligência energética
        </span>
      </div>

      <h1 class="h-display mx-auto mt-7 max-w-5xl text-balance">
        Engenharia elétrica, conexão e inteligência técnica em uma única interface de decisão.
      </h1>
      <p class="text-lead mx-auto mt-7 max-w-3xl">
        A Conexium Engenharia organiza projetos, pareceres, faturas, laudos, medições e normas em diagnósticos técnicos claros para empresas, integradores e operações que precisam decidir com segurança.
      </p>

      <div class="showcase-search-shell mx-auto mt-10 flex max-w-3xl items-center gap-3 rounded-full border border-white/10 bg-white/[.055] p-2 shadow-[0_24px_80px_rgba(0,0,0,.28)] backdrop-blur-2xl transition">
        <label for="showcase-search" class="sr-only">Buscar desafio técnico</label>
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/[.06] text-cx-cyan" aria-hidden="true">
          <span class="relative h-5 w-5 rounded-full border-2 border-current after:absolute after:-bottom-1 after:-right-1 after:h-2 after:w-2 after:rotate-45 after:rounded-full after:bg-current"></span>
        </div>
        <input
          id="showcase-search"
          data-showcase-search
          class="min-w-0 flex-1 bg-transparent text-sm text-white placeholder:text-white/40 outline-none"
          type="search"
          autocomplete="off"
          placeholder="Qual desafio técnico você precisa resolver?"
        />
        <a
          href={withBase("/contato/")}
          class="hidden rounded-full bg-cx-text px-5 py-3 text-xs font-semibold uppercase tracking-[.12em] text-cx-void transition hover:bg-cx-cyan sm:inline-flex"
          data-track="hero-diagnostico"
        >
          Diagnóstico
        </a>
      </div>

      <div class="mx-auto mt-4 flex max-w-4xl flex-wrap justify-center gap-2 text-left">
        {showcaseSuggestions.map((suggestion) => (
          <button
            type="button"
            class="rounded-full border border-white/10 bg-white/[.035] px-3 py-1.5 text-xs font-semibold text-white/52 transition hover:border-cx-cyan/40 hover:text-white"
            data-showcase-suggestion={suggestion}
          >
            {suggestion}
          </button>
        ))}
      </div>

      <div class="mx-auto mt-5 flex max-w-5xl gap-2 overflow-x-auto px-1 pb-2 sm:justify-center" aria-label="Filtrar soluções técnicas">
        {showcaseFilters.map((filter, index) => (
          <button
            type="button"
            class:list={[
              "showcase-filter shrink-0 rounded-full border px-4 py-2 text-[0.68rem] font-semibold uppercase tracking-[.13em] transition",
              index === 0
                ? "is-active border-cx-gold/60 bg-cx-gold/10 text-cx-gold-soft"
                : "border-white/10 bg-white/[.035] text-white/50 hover:border-cx-cyan/40 hover:text-white",
            ]}
            data-showcase-filter={filter}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {filter}
          </button>
        ))}
      </div>

      <div class="mt-7 flex flex-col justify-center gap-3 sm:hidden">
        <a href={withBase("/contato/")} class="inline-flex items-center justify-center rounded-full bg-cx-text px-6 py-3 text-sm font-semibold text-cx-void transition hover:bg-cx-cyan">
          Solicitar diagnóstico técnico <span class="ml-2" aria-hidden="true">-&gt;</span>
        </a>
        <a href="#areas" class="inline-flex items-center justify-center rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white/75 transition hover:border-cx-cyan/50 hover:text-white">
          Ver áreas de atuação
        </a>
      </div>
    </div>

    <div class="relative z-10 mx-auto mt-14 w-[min(100%,1320px)]">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-6 xl:grid-cols-12">
        {showcaseSolutions.map((solution, index) => (
          <article
            class:list={[
              "cx-showcase-card reveal group flex min-h-[390px] flex-col p-4",
              solution.featured ? "md:col-span-6 xl:col-span-5 xl:min-h-[455px]" : "md:col-span-3 xl:min-h-[405px]",
              index === 1 ? "xl:col-span-4" : "",
              index === 2 ? "xl:col-span-3" : "",
              index > 2 ? "xl:col-span-4" : "",
            ]}
            style={`--reveal-delay:${index * 60}ms`}
            data-showcase-card
            data-category={solution.category}
            data-search={`${solution.title} ${solution.description} ${solution.tags.join(" ")}`}
          >
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(88,224,212,.14),transparent_22rem)] opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            <a href={withBase(solution.href)} class="relative flex h-full flex-col" aria-label={`${solution.cta}: ${solution.title}`}>
              <div class:list={["mockup-frame", `mockup-${solution.variant}`]}>
                <div class="flex h-8 items-center gap-2 border-b border-white/10 bg-white/[.04] px-3">
                  <span class="h-2 w-2 rounded-full bg-cx-gold-soft"></span>
                  <span class="h-2 w-2 rounded-full bg-cx-cyan/70"></span>
                  <span class="h-2 w-2 rounded-full bg-white/25"></span>
                  <span class="ml-3 h-3 w-28 rounded-full bg-white/10"></span>
                </div>

                <div class="mockup-canvas">
                  {solution.variant === "access" && (
                    <>
                      <div class="mockup-network">
                        <span></span><span></span><span></span><span></span>
                      </div>
                      <div class="mockup-panel left">
                        <strong>Premissas</strong>
                        <i></i><i></i><i></i>
                      </div>
                      <div class="mockup-panel right">
                        <strong>Matriz</strong>
                        <i></i><i></i>
                      </div>
                      <div class="mockup-chart"><span></span><span></span><span></span><span></span><span></span></div>
                    </>
                  )}

                  {solution.variant === "project" && (
                    <>
                      <div class="mockup-blueprint-lines"></div>
                      <div class="mockup-diagram">
                        <span></span><span></span><span></span><span></span><span></span>
                      </div>
                      <div class="mockup-stamp">BT/MT</div>
                    </>
                  )}

                  {solution.variant === "forensics" && (
                    <>
                      <div class="mockup-document">
                        <strong>Quesitos técnicos</strong>
                        <i></i><i></i><i></i><i></i>
                      </div>
                      <div class="mockup-evidence"><span></span><span></span><span></span></div>
                    </>
                  )}

                  {solution.variant === "data" && (
                    <>
                      <div class="mockup-kpis"><span>kWh</span><span>kW</span><span>R$</span></div>
                      <div class="mockup-bars"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                      <div class="mockup-line"></div>
                    </>
                  )}

                  {solution.variant === "mobility" && (
                    <>
                      <div class="mockup-charge-map">
                        <span></span><span></span><span></span><span></span>
                      </div>
                      <div class="mockup-load-card">Nova carga</div>
                      <div class="mockup-flow"></div>
                    </>
                  )}

                  {solution.variant === "integrators" && (
                    <div class="mockup-bento">
                      <span>Revisão</span>
                      <span>Parecer</span>
                      <span>Contestação</span>
                      <span>Checklist</span>
                    </div>
                  )}
                </div>
              </div>

              <div class="mt-5 flex items-start gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[.055]">
                  <img src={withBase("/brand/conexium-symbol.svg")} alt="" class="h-5 w-5" width="20" height="20" />
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[.14em] text-cx-gold-soft/70">{solution.category}</p>
                  <h2 class="mt-2 text-[clamp(1.05rem,1.35vw,1.35rem)] font-medium leading-tight text-cx-text">
                    {solution.title}
                  </h2>
                </div>
              </div>

              <p class="mt-4 line-clamp-2 text-sm leading-7 text-white/58">{solution.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {solution.tags.map((tag) => (
                  <span class="showcase-tag rounded-full border border-white/10 bg-white/[.035] px-3 py-1 text-[10px] font-semibold uppercase tracking-[.14em] text-white/45 transition">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="mt-auto inline-flex pt-5 text-sm font-medium text-cx-cyan opacity-80 transition group-hover:opacity-100">
                {solution.cta} <span class="ml-2 transition group-hover:translate-x-1" aria-hidden="true">-&gt;</span>
              </span>
            </a>
          </article>
        ))}
      </div>
      <p class="showcase-empty mt-8 hidden rounded-full border border-white/10 bg-white/[.04] px-5 py-4 text-center text-sm text-cx-muted">
        Nenhuma solução apareceu para esse filtro. Tente outro termo técnico.
      </p>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.querySelector("[data-showcase-search]");
    const cards = Array.from(document.querySelectorAll("[data-showcase-card]"));
    const filters = Array.from(document.querySelectorAll("[data-showcase-filter]"));
    const suggestions = Array.from(document.querySelectorAll("[data-showcase-suggestion]"));
    const emptyState = document.querySelector(".showcase-empty");
    let activeFilter = "Todos";

    function normalize(value) {
      return value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }

    function applyShowcaseFilters() {
      const query = normalize(searchInput?.value || "");
      let visibleCount = 0;

      cards.forEach((card) => {
        const category = card.getAttribute("data-category") || "";
        const searchable = normalize(card.getAttribute("data-search") || "");
        const matchesFilter = activeFilter === "Todos" || category === activeFilter || searchable.includes(normalize(activeFilter));
        const matchesSearch = !query || searchable.includes(query);
        const isVisible = matchesFilter && matchesSearch;

        card.classList.toggle("hidden", !isVisible);
        visibleCount += isVisible ? 1 : 0;
      });

      emptyState?.classList.toggle("hidden", visibleCount > 0);
    }

    filters.forEach((filter) => {
      filter.addEventListener("click", () => {
        activeFilter = filter.getAttribute("data-showcase-filter") || "Todos";
        filters.forEach((item) => {
          const isActive = item === filter;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });
        applyShowcaseFilters();
      });
    });

    suggestions.forEach((suggestion) => {
      suggestion.addEventListener("click", () => {
        if (!searchInput) return;
        searchInput.value = suggestion.getAttribute("data-showcase-suggestion") || "";
        searchInput.focus();
        applyShowcaseFilters();
      });
    });

    searchInput?.addEventListener("input", applyShowcaseFilters);
  </script>

  <section class="border-b border-white/10 bg-cx-void px-5 py-8 text-cx-text sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {credibility.map((item) => (
        <div class="reveal rounded-md border border-white/10 bg-white/5 px-5 py-5">
          <p class="text-2xl font-semibold text-cx-gold">{item.value}</p>
          <p class="mt-2 text-sm leading-6 text-cx-muted">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="areas" class="cx-section bg-cx-void px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        dark
        eyebrow="Áreas de atuação"
        title="Especialidades conectadas para reduzir risco técnico antes da decisão."
        description="Atuação em energia, conexão, infraestrutura elétrica, regulação, perícias e dados energéticos, com foco em clareza, rastreabilidade e viabilidade."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {practiceAreas.map((area) => (
          <article class="cx-card reveal flex h-full flex-col p-5">
            <h3 class="text-lg font-semibold text-cx-text">{area.title}</h3>
            <p class="mt-3 text-sm leading-6 text-cx-muted">{area.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {area.tags.map((tag) => <span class="rounded-full border border-white/10 bg-white/6 px-2.5 py-1 text-[11px] font-bold text-cx-muted">{tag}</span>)}
            </div>
            <a href={withBase(area.href)} class="mt-auto pt-6 text-sm font-semibold text-cx-cyan">Ver detalhes <span aria-hidden="true">-&gt;</span></a>
          </article>
        ))}
      </div>
      <div class="reveal mt-8 rounded-[1rem] border border-white/10 bg-white/5 p-6">
        <div class="grid gap-5 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div>
            <h3 class="text-xl font-semibold text-cx-text">Dados, automação e inteligência energética</h3>
            <p class="mt-3 text-sm leading-7 text-cx-muted">
              Automação aplicada a faturas, indicadores, documentação e rotinas técnicas, sempre com revisão de engenharia.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 lg:justify-end">
            {intelligenceChips.map((chip) => <span class="rounded-full border border-cx-cyan/25 bg-cx-cyan/10 px-3 py-2 text-xs font-bold text-cx-cyan">{chip}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f6f8f7] px-5 py-20 text-slate-950 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.88fr_1.12fr] lg:items-center">
      <div class="reveal">
        <p class="eyebrow text-cx-teal">Para integradores e empresas</p>
        <h2 class="h-section mt-4 max-w-3xl text-balance">Um apoio técnico discreto para destravar conexão, documentação e viabilidade.</h2>
        <p class="mt-5 text-base leading-8 text-slate-600">
          A Conexium atua como camada técnica para revisar premissas, organizar evidências e sustentar decisões em projetos de energia que dependem de distribuidoras, normas e documentação rastreável.
        </p>
        <a href={withBase("/para-integradores/")} class="mt-7 inline-flex rounded-full bg-cx-void px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-cx-deep">
          Ver apoio para integradores <span class="ml-2" aria-hidden="true">-&gt;</span>
        </a>
      </div>
      <div class="grid gap-3">
        {integratorChecks.map((item) => (
          <div class="reveal flex gap-4 rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
            <span class="mt-1 h-2.5 w-2.5 rounded-full bg-cx-teal shadow-[0_0_18px_rgba(14,124,115,.45)]" aria-hidden="true"></span>
            <p class="text-sm leading-7 text-slate-700">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cx-void px-5 py-20 text-cx-text sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.72fr_1.28fr]">
      <SectionHeading dark eyebrow="Método" title="Diagnóstico, evidência, estratégia e entrega rastreável." />
      <div class="grid gap-4 sm:grid-cols-2">
        {methodSteps.map((step, index) => (
          <article class="cx-card reveal p-6">
            <p class="eyebrow text-cx-gold">Etapa {String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 text-xl font-semibold text-white">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-cx-muted">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#f6f8f7] px-5 py-20 text-slate-950 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
        <div>
          <SectionHeading
            eyebrow="Perícias, quesitos e evidências técnicas"
            title="Documentos técnicos convertidos em perguntas, evidências e pareceres."
            description="Apoio para medições, faturas, projetos e eventos elétricos, dentro dos limites profissionais."
          />
          <p class="reveal mt-6 rounded-md border border-slate-200 bg-white p-4 text-sm leading-7 text-slate-600 shadow-crisp">
            A atuação é técnica. Demandas jurídicas devem ser conduzidas por advogado habilitado.
          </p>
        </div>
        <div class="grid gap-4">
          {forensicCards.map((card) => (
            <article class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
              <h3 class="text-lg font-semibold text-slate-950">{card.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{card.text}</p>
            </article>
          ))}
          <a href={withBase("/servicos/pericias-quesitos-pareceres/")} class="inline-flex w-fit rounded-full bg-cx-void px-5 py-3 text-sm font-semibold text-white transition hover:bg-cx-deep">Conhecer apoio pericial técnico <span class="ml-2" aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cx-void px-5 py-20 text-cx-text sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        dark
        eyebrow="Cenários de referência"
        title="Problemas técnicos anonimizados, apresentados como cenários de decisão."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {cases.slice(0, 3).map((study, index) => (
          <article class:list={["cx-card reveal p-6", index === 0 ? "lg:col-span-2" : ""]}>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full border border-cx-cyan/25 bg-cx-cyan/10 px-3 py-1 text-xs font-bold text-cx-cyan">{study.category}</span>
              <span class="rounded-full border border-white/10 bg-white/6 px-3 py-1 text-xs font-semibold text-cx-muted">{study.label}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-cx-text">{study.title}</h3>
            <p class="mt-4 text-sm leading-7 text-cx-muted">{study.challenge}</p>
            <p class="mt-4 text-sm font-semibold text-cx-text">{study.impact}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#f6f8f7] px-5 py-20 text-slate-950 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Perfis atendidos"
        title="Engenharia para quem precisa decidir com base técnica."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        {profileSolutions.map((solution) => (
          <article class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
            <h3 class="text-lg font-semibold text-slate-950">{solution.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{solution.text}</p>
            <a href={withBase(solution.href)} class="mt-5 inline-flex text-sm font-semibold text-cx-teal">Ver rota <span class="ml-2" aria-hidden="true">-&gt;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Envie o problema técnico para uma leitura inicial." label="Solicitar diagnóstico técnico" />

  <section class="bg-cx-void px-5 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <SectionHeading dark eyebrow="FAQ" title="Perguntas frequentes antes do diagnóstico técnico." />
      <div class="mt-10 grid gap-4">
        {faqs.map((faq) => (
          <details class="cx-card reveal p-5">
            <summary class="cursor-pointer text-lg font-semibold text-cx-text">{faq.question}</summary>
            <p class="mt-4 text-sm leading-7 text-cx-muted">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
