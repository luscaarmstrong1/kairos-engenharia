---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CtaBand from "@components/CtaBand.astro";
import { cases, faqs, profileSolutions } from "@data/site";
import { withBase } from "@lib/urls";

const keyAreas = [
  "Conexão e GD",
  "Projetos elétricos",
  "Regulação",
  "Perícias e quesitos",
  "Inteligência energética",
  "Eletromobilidade",
];
const intelligenceChips = ["Python", "VBA", "Planilhas inteligentes", "Dashboards técnicos"];

const practiceAreas = [
  {
    title: "Conexão, geração distribuída e parecer de acesso",
    description:
      "Apoio técnico em conexão, orçamentos, pareceres, inversão de fluxo, alternativas, aumento de carga e tratativas com distribuidoras.",
    tags: ["GD", "Parecer de acesso", "Inversão de fluxo"],
    href: "/servicos/consultoria-regulatoria/",
  },
  {
    title: "Engenharia e projetos elétricos",
    description:
      "Projetos e revisões para BT/MT, fotovoltaico, subestações, entrada de energia, proteção, seletividade, quadros e geradores.",
    tags: ["BT/MT", "Subestações", "Proteção"],
    href: "/servicos/engenharia-projetos-eletricos/",
  },
  {
    title: "Consultoria técnico-regulatória",
    description:
      "Análise técnica e normativa de documentos de distribuidoras, prazos, exigências, contestações e evidências.",
    tags: ["Regulação", "Distribuidoras", "ANEEL"],
    href: "/servicos/consultoria-regulatoria/",
  },
  {
    title: "Perícias, quesitos e pareceres técnicos",
    description:
      "Quesitos, análise de laudos, pareceres técnicos, matriz de evidências e assistência técnica em engenharia elétrica.",
    tags: ["Quesitos", "Laudos", "Evidências"],
    href: "/servicos/pericias-quesitos-pareceres/",
  },
  {
    title: "Inteligência energética e análise de faturas",
    description: "Consumo, demanda, faturas, enquadramento tarifário, indicadores, dashboards e decisão energética.",
    tags: ["Faturas", "Demanda", "Indicadores"],
    href: "/servicos/inteligencia-energetica/",
  },
  {
    title: "Eletromobilidade e novas cargas",
    description: "Viabilidade e projeto para eletropostos, hubs, frotas, condomínios, postos e novas cargas conectadas à rede.",
    tags: ["Recarga", "Eletropostos", "Novas cargas"],
    href: "/servicos/eletromobilidade/",
  },
  {
    title: "Backup, continuidade e operações críticas",
    description: "Análise e projetos com geradores, QTA, cargas prioritárias, continuidade, proteção e confiabilidade elétrica.",
    tags: ["Geradores", "QTA", "Operação crítica"],
    href: "/servicos/engenharia-projetos-eletricos/",
  },
  {
    title: "Automação técnica e gestão documental",
    description: "Planilhas inteligentes, Python, VBA, dashboards, documentos, formulários, protocolos e evidências.",
    tags: ["Python", "VBA", "Dashboards"],
    href: "/servicos/inteligencia-energetica/",
  },
];

const methodSteps = [
  {
    title: "Diagnóstico técnico",
    text: "Leitura do problema, documentos, restrições e objetivo.",
  },
  {
    title: "Organização de evidências",
    text: "Estruturação de dados, faturas, projetos, medições e normas.",
  },
  {
    title: "Estratégia técnica",
    text: "Cenários, riscos, alternativas, quesitos e premissas.",
  },
  {
    title: "Entrega rastreável",
    text: "Relatório, parecer, memorial, matriz ou documentação técnica.",
  },
];

const forensicCards = [
  {
    title: "Elaboração de quesitos técnicos",
    text: "Perguntas objetivas para temas de energia, GD, danos, consumo, demanda e instalações.",
  },
  {
    title: "Análise de laudos e pareceres",
    text: "Leitura técnica de laudos, medições, faturas, projetos, fotos e diagramas.",
  },
  {
    title: "Assistência técnica e evidências",
    text: "Matriz de evidências, linha do tempo, normas, cálculos e subsídios técnicos.",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: "https://luscaarmstrong1.github.io/kairos-engenharia/" },
  ],
};
---

<BaseLayout
  title="Kairós Engenharia | Engenharia elétrica para energia, conexão e regulação"
  description="Engenharia elétrica, conexão à rede, geração distribuída, regulação, perícias técnicas, quesitos, inteligência energética e eletromobilidade para empresas e integradores."
  path="/"
  jsonLd={breadcrumbJsonLd}
>
  <section class="relative isolate overflow-hidden bg-navy-950 pt-32 text-white">
    <div class="absolute inset-0 bg-hero-grid bg-[size:42px_42px] opacity-70" aria-hidden="true"></div>
    <div class="noise"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 pb-20 sm:px-6 lg:grid-cols-[1fr_.82fr] lg:px-8">
      <div class="flex flex-col justify-center">
        <p class="inline-flex w-fit rounded-full border border-energy-300/25 bg-white/7 px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] text-energy-300">
          Engenharia elétrica • Regulação • Perícia técnica • Inteligência energética
        </p>
        <h1 class="mt-7 max-w-4xl text-balance text-4xl font-semibold leading-[1.06] tracking-normal text-white sm:text-5xl lg:text-6xl">
          Engenharia elétrica para decisões seguras em energia, conexão e regulação.
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
          A Kairós Engenharia atua em projetos elétricos, geração distribuída, análise de conexão, consultoria técnico-regulatória, perícias, quesitos técnicos, inteligência energética e infraestrutura para novas cargas.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-400">
          Transformamos documentos, projetos, faturas, pareceres, medições e normas em diagnósticos claros, tecnicamente fundamentados e prontos para orientar decisões.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={withBase("/contato/")} class="inline-flex items-center justify-center rounded-md bg-energy-400 px-5 py-3 text-sm font-semibold text-navy-950 transition hover:bg-energy-300" data-track="hero-diagnostico">
            Solicitar diagnóstico técnico <span class="ml-2" aria-hidden="true">→</span>
          </a>
          <a href="#areas" class="inline-flex items-center justify-center rounded-md border border-white/16 bg-white/6 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/12" data-track="hero-areas">
            Conhecer áreas de atuação
          </a>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
          <a href={withBase("/servicos/consultoria-regulatoria/")} class="rounded-md border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10">Parecer de acesso e inversão de fluxo</a>
          <a href={withBase("/servicos/engenharia-projetos-eletricos/")} class="rounded-md border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10">Projetos BT/MT</a>
          <a href={withBase("/servicos/pericias-quesitos-pareceres/")} class="rounded-md border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10">Perícias e quesitos técnicos</a>
          <a href={withBase("/servicos/eletromobilidade/")} class="rounded-md border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10">Eletromobilidade</a>
          <a href={withBase("/servicos/inteligencia-energetica/")} class="rounded-md border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-white/10">Inteligência energética</a>
        </div>
      </div>
      <div class="reveal relative min-h-[470px]">
        <div class="absolute inset-0 rounded-md border border-white/10 bg-white/6 shadow-glow backdrop-blur"></div>
        <div class="screen-grid absolute inset-5 overflow-hidden rounded-md border border-white/12 bg-[#071a2e] p-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Mapa técnico</p>
          <h2 class="mt-2 text-xl font-semibold text-white">Evidência, viabilidade e decisão</h2>
          <div class="mt-8 grid gap-3">
            {["Conexão", "Demanda", "Proteção", "Perícia", "Regulação", "Recarga"].map((item, index) => (
              <div class="flex items-center justify-between rounded-md border border-white/10 bg-white/5 px-4 py-3">
                <span class="text-sm text-slate-300">{item}</span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-energy-300">{index % 2 ? "modelar" : "auditar"}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 rounded-md border border-white/10 bg-navy-950/70 p-5">
            <svg viewBox="0 0 520 220" class="h-auto w-full" role="img" aria-label="Diagrama abstrato de curva de carga e conexão">
              <path d="M35 184H488M35 134H488M35 84H488" stroke="rgba(226,232,240,.13)" />
              <path d="M42 168C95 130 126 70 180 112C231 151 244 174 300 119C350 70 389 82 444 132C464 151 480 161 494 164" fill="none" stroke="#2DD4BF" stroke-width="6" stroke-linecap="round" />
              <path d="M44 188C118 174 154 155 230 176C308 198 360 160 490 146" fill="none" stroke="#94A3B8" stroke-width="3" stroke-dasharray="7 8" stroke-linecap="round" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-10 text-slate-900 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-3 sm:grid-cols-2 lg:grid-cols-6">
      {keyAreas.map((item) => (
        <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-4 text-sm font-semibold text-slate-700">{item}</div>
      ))}
    </div>
  </section>

  <section id="areas" class="bg-white px-5 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Áreas de atuação"
        title="Áreas de atuação"
        description="Atuação técnica em energia, conexão, infraestrutura elétrica, regulação, perícias e dados energéticos, com foco em clareza, rastreabilidade e viabilidade."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {practiceAreas.map((area) => (
          <article class="reveal flex h-full flex-col rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
            <h3 class="text-lg font-semibold text-slate-950">{area.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{area.description}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {area.tags.map((tag) => <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">{tag}</span>)}
            </div>
            <a href={withBase(area.href)} class="mt-auto pt-6 text-sm font-semibold text-energy-700">Ver detalhes <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <div class="mt-8 rounded-md border border-slate-200 bg-slate-50 p-6">
        <div class="grid gap-5 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
          <div>
            <h3 class="text-xl font-semibold text-slate-950">Dados, automação e inteligência energética</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              Automação aplicada a faturas, indicadores, documentação e rotinas técnicas, com revisão de engenharia.
            </p>
          </div>
          <div class="flex flex-wrap gap-2 lg:justify-end">
            {intelligenceChips.map((chip) => <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700">{chip}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Perfis atendidos"
        title="Engenharia para quem precisa decidir com base técnica."
      />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        {profileSolutions.map((solution) => (
          <article class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
            <h3 class="text-lg font-semibold text-slate-950">{solution.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{solution.text}</p>
            <a href={withBase(solution.href)} class="mt-5 inline-flex text-sm font-semibold text-energy-700">Ver rota <span class="ml-2" aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy-950 px-5 py-20 text-white sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.72fr_1.28fr]">
      <SectionHeading dark eyebrow="Método" title="Diagnóstico, evidência, estratégia e entrega rastreável." />
      <div class="grid gap-4 sm:grid-cols-2">
        {methodSteps.map((step, index) => (
          <article class="reveal rounded-md border border-white/10 bg-white/5 p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-energy-300">Etapa {String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 text-xl font-semibold text-white">{step.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-300">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
        <div>
          <SectionHeading
            eyebrow="Perícias, quesitos e evidências técnicas"
        title="Documentos técnicos convertidos em perguntas, evidências e pareceres."
        description="Apoio para medições, faturas, projetos e eventos elétricos, dentro dos limites profissionais."
          />
          <p class="mt-6 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm leading-7 text-slate-600">
            A atuação é técnica. Demandas jurídicas devem ser conduzidas por advogado habilitado.
          </p>
        </div>
        <div class="grid gap-4">
          {forensicCards.map((card) => (
            <article class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
              <h3 class="text-lg font-semibold text-slate-950">{card.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600">{card.text}</p>
            </article>
          ))}
          <a href={withBase("/servicos/pericias-quesitos-pareceres/")} class="inline-flex w-fit rounded-md bg-navy-950 px-5 py-3 text-sm font-semibold text-white">Conhecer apoio pericial técnico <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Cenários de referência"
        title="Exemplos anonimizados de problemas técnicos que orientam a forma de atuação."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {cases.slice(0, 3).map((study) => (
          <article class="reveal rounded-md border border-slate-200 bg-white p-6 shadow-crisp">
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full bg-energy-400/12 px-3 py-1 text-xs font-bold text-energy-700">{study.category}</span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{study.label}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-slate-950">{study.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{study.challenge}</p>
            <p class="mt-4 text-sm font-semibold text-slate-800">{study.impact}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Envie o problema técnico para uma leitura inicial." label="Solicitar diagnóstico técnico" />

  <section class="bg-white px-5 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <SectionHeading eyebrow="FAQ" title="Perguntas frequentes antes do diagnóstico técnico." />
      <div class="mt-10 grid gap-4">
        {faqs.map((faq) => (
          <details class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
            <summary class="cursor-pointer text-lg font-semibold text-slate-950">{faq.question}</summary>
            <p class="mt-4 text-sm leading-7 text-slate-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
