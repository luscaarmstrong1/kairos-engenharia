---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CtaBand from "@components/CtaBand.astro";
import { servicePages, site } from "@data/site";
import { absoluteUrl, withBase } from "@lib/urls";

export function getStaticPaths() {
  return servicePages.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const path = `/servicos/${service.slug}/`;
const isForensic = service.slug === "pericias-quesitos-pareceres";
const forensicIntro = [
  "Questões técnicas envolvendo energia elétrica costumam exigir mais do que uma leitura superficial de documentos. Faturas, fotos, medições, diagramas, laudos, notificações, histórico de consumo e normas aplicáveis precisam ser organizados de forma lógica para que a discussão técnica seja clara, objetiva e verificável.",
  "A Kairós Engenharia atua na estruturação dessa análise, elaborando quesitos técnicos, pareceres, memórias de cálculo, matrizes de evidências e revisões de documentos. O objetivo é apoiar partes interessadas, assistentes técnicos, advogados e empresas com uma visão técnica fundamentada em engenharia elétrica.",
];
const forensicGroups = [
  {
    title: "Quando atuamos",
    items: [
      "danos elétricos",
      "variação ou qualidade de energia",
      "consumo elevado",
      "consumo incompatível com o histórico",
      "medição de energia",
      "demanda contratada",
      "ultrapassagem de demanda",
      "geração distribuída",
      "inversão de fluxo",
      "parecer de acesso",
      "indeferimento de conexão",
      "instalações elétricas",
      "subestações",
      "proteção elétrica",
      "faturas",
      "responsabilidade técnica",
      "análise de laudos",
      "divergências com concessionárias",
      "documentação técnica incompleta ou contraditória",
    ],
  },
  {
    title: "Entregáveis",
    items: [
      "quesitos técnicos",
      "parecer técnico",
      "análise de laudo",
      "matriz de evidências",
      "linha do tempo técnica",
      "memória de cálculo",
      "revisão documental",
      "subsídios técnicos para manifestação",
      "assistência técnica pericial",
    ],
  },
  {
    title: "Como trabalhamos",
    items: [
      "leitura dos documentos",
      "organização das evidências",
      "identificação de lacunas",
      "formulação dos quesitos",
      "análise técnica",
      "entrega rastreável",
    ],
  },
];
const forensicDetailSections = [
  {
    title: "Elaboração de quesitos técnicos",
    paragraphs: [
      "Os quesitos são perguntas técnicas que orientam a perícia e ajudam a esclarecer pontos relevantes da controvérsia. Uma boa formulação deve ser objetiva, tecnicamente pertinente e capaz de conduzir a respostas verificáveis.",
      "A Kairós elabora quesitos em linguagem técnica adequada, considerando o contexto do caso, os documentos disponíveis, as normas aplicáveis e os pontos que precisam ser esclarecidos.",
    ],
  },
  {
    title: "Análise de laudos e documentos",
    paragraphs: [
      "Laudos técnicos podem conter premissas incompletas, ausência de medições, conclusões sem memória de cálculo, análise limitada de documentos ou omissão de elementos relevantes.",
      "A Kairós avalia laudos, fotos, faturas, medições, relatórios, projetos, diagramas, notificações, documentos de distribuidoras e registros operacionais.",
    ],
  },
  {
    title: "Parecer técnico",
    paragraphs: [
      "O parecer técnico organiza a análise de engenharia em documento estruturado, com linguagem clara, premissas explícitas, evidências, limitações e conclusões técnicas.",
      "Ele pode apoiar manifestação administrativa, avaliação interna, negociação, análise de risco, contestação técnica ou o trabalho de assistentes técnicos e advogados.",
    ],
  },
  {
    title: "Matriz de evidências",
    paragraphs: [
      "A matriz de evidências organiza os documentos do caso e relaciona cada fato técnico a uma evidência específica, evitando que a análise fique dispersa.",
      "Essa organização facilita a leitura do caso, reduz redundâncias e aumenta a rastreabilidade da análise.",
    ],
  },
];
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: site.url },
    { "@type": "ListItem", position: 2, name: "Serviços", item: absoluteUrl("/servicos/") },
    { "@type": "ListItem", position: 3, name: service.title, item: absoluteUrl(path) },
  ],
};
---

<BaseLayout title={service.title} description={service.description} path={path} jsonLd={breadcrumbJsonLd}>
  <PageHero
    eyebrow={service.eyebrow}
    title={isForensic ? "Perícias, Quesitos e Pareceres Técnicos em Engenharia Elétrica" : service.title}
    description={isForensic ? "Apoio técnico para disputas, análises administrativas, processos, laudos e manifestações envolvendo energia elétrica, instalações, consumo, danos, conexão e geração distribuída." : service.description}
    primaryHref={withBase("/contato/")}
    primaryLabel={isForensic ? "Enviar documentos para análise técnica" : "Solicitar diagnóstico técnico"}
    secondaryHref={withBase("/servicos/")}
    secondaryLabel="Ver todos os serviços"
  />

  {isForensic ? (
    <section class="bg-white px-5 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <SectionHeading
          eyebrow="Escopo técnico"
          title="Perguntas, evidências e pareceres compreensíveis."
          description="O trabalho transforma documentos, medições, faturas, projetos e eventos elétricos em evidências organizadas, perguntas objetivas e leitura técnica rastreável."
        />
        <div class="mt-8 grid gap-4 text-base leading-8 text-slate-700 lg:grid-cols-2">
          {forensicIntro.map((paragraph) => <p class="rounded-md border border-slate-200 bg-slate-50 p-5">{paragraph}</p>)}
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {forensicGroups.map((group) => (
            <article class="reveal rounded-md border border-slate-200 bg-white p-6 shadow-crisp">
              <h2 class="text-xl font-semibold text-slate-950">{group.title}</h2>
              <ul class="mt-5 grid gap-3 text-sm leading-6 text-slate-600">
                {group.items.map((item) => <li class="rounded-md bg-slate-50 px-3 py-2">{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-2">
          {forensicDetailSections.map((section) => (
            <article class="reveal rounded-md border border-slate-200 bg-white p-6 shadow-crisp">
              <h2 class="text-xl font-semibold text-slate-950">{section.title}</h2>
              <div class="mt-4 grid gap-3 text-sm leading-7 text-slate-600">
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-white px-5 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr]">
        <SectionHeading
          eyebrow="Escopo técnico"
          title="O que pode ser analisado e estruturado nesta frente."
          description="A lista abaixo orienta o diagnóstico inicial. A entrega final depende de documentos, premissas, contratação e responsabilidade técnica definida."
        />
        <div class="grid gap-4 sm:grid-cols-2">
          {service.sections.map((item) => (
            <div class="reveal rounded-md border border-slate-200 bg-white p-5 shadow-crisp">
              <h2 class="text-lg font-semibold text-slate-950">{item}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">Premissas, riscos, documentos e evidências são organizados para decisão técnica proporcional.</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-slate-50 px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-md border border-slate-200 bg-white p-7 shadow-crisp">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-energy-600">{isForensic ? "Aviso de escopo" : "Nota de escopo"}</p>
      <p class="mt-4 text-base leading-8 text-slate-700">{service.note}</p>
    </div>
  </section>

  <CtaBand title={isForensic ? "Envie documentos para análise técnica." : "Transforme o problema técnico em rota de decisão."} label={isForensic ? "Enviar documentos para análise técnica" : "Solicitar diagnóstico técnico"} />
</BaseLayout>
