---
import BaseLayout from "@layouts/BaseLayout.astro";
import { servicePages } from "@data/site";
import { withBase } from "@lib/urls";
---

<BaseLayout
  title="Soluções Técnicas | Conexium Engenharia"
  description="Engenharia, regulação e evidência técnica aplicadas a projetos, processos e decisões do setor elétrico."
  path="/servicos/"
>
  <!-- Hero Section Serviços -->
  <section class="relative isolate overflow-hidden border-b border-white/[0.08] bg-[#001F1A] py-20 text-white font-sans-tech">
    <div class="pointer-events-none absolute inset-0 tech-grid-pattern opacity-50" aria-hidden="true"></div>

    <div class="cx-shell relative z-10">
      <div class="flex items-center gap-2 mb-3.5">
        <span class="inline-block h-[1px] w-4 bg-[#C79A3B]" aria-hidden="true"></span>
        <p class="text-[11px] sm:text-[12px] font-semibold tracking-[0.2em] text-[#C79A3B] uppercase">
          CONEXIUM ENGENHARIA
        </p>
      </div>
      <h1 class="font-serif-display text-[clamp(2.4rem,3.6vw,3.6rem)] text-white leading-tight">
        Soluções técnicas
      </h1>
      <p class="mt-4 max-w-2xl text-[15.5px] sm:text-[16.5px] text-[#F7F4EC]/85 leading-relaxed">
        Engenharia, regulação e evidência técnica aplicadas a projetos, processos e decisões do setor elétrico.
      </p>
    </div>
  </section>

  <!-- 3 Pilares Principais com Alternância Rítmica de Superfícies -->
  <section class="bg-[#001F1A] py-20 lg:py-24 text-white font-sans-tech">
    <div class="cx-shell space-y-16">
      {servicePages.map((service, index) => {
        const isIvory = index === 1;
        return (
          <article class={`grid items-center gap-10 rounded-[8px] border p-6 lg:grid-cols-2 lg:p-10 transition hover:shadow-xl ${
            isIvory
              ? "bg-[#F7F4EC] text-[#18211F] border-[#18211F]/15 hover:border-[#C79A3B]/60"
              : "bg-[#042923] text-white border-white/[0.08] hover:border-[#C79A3B]/40"
          }`}>
            <div class={index % 2 === 1 ? "lg:order-2" : ""}>
              <div class="flex items-center gap-2.5 mb-2.5">
                <span class="text-xs font-bold text-[#C79A3B]">0{index + 1}</span>
                <span class={`h-[1px] w-3 ${isIvory ? "bg-[#C79A3B]" : "bg-[#C79A3B]/40"}`}></span>
                <p class="text-[11px] font-bold tracking-widest text-[#C79A3B] uppercase">
                  {service.eyebrow}
                </p>
              </div>
              <h2 class={`font-serif-display text-2xl lg:text-3xl ${isIvory ? "text-[#001F1A]" : "text-white"}`}>
                {service.title}
              </h2>
              <p class={`mt-4 text-[14.5px] leading-relaxed ${isIvory ? "text-[#18211F]/80" : "text-[#F7F4EC]/80"}`}>
                {service.cardDescription}
              </p>

              <div class="mt-6">
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#C79A3B]">Escopo de atuação</h3>
                <ul class={`mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-[13px] ${isIvory ? "text-[#18211F]/75" : "text-[#A7ACA8]"}`}>
                  {service.sections.slice(0, 6).map((sec) => (
                    <li class="flex items-center gap-2">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#C79A3B]"></span>
                      <span>{sec}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 flex items-center gap-4">
                <a href={withBase(`/servicos/${service.slug}/`)} class="btn-gold">
                  Saiba mais →
                </a>
                <a href={withBase(`/contato/?servico=${service.slug}`)} class={isIvory ? "btn-secondary-light" : "btn-secondary-dark"}>
                  Solicitar avaliação
                </a>
              </div>
            </div>

            <div class={`overflow-hidden rounded-[6px] h-[280px] sm:h-[340px] border ${
              isIvory ? "border-[#18211F]/15 bg-[#EAE5D8]" : "border-white/[0.08] bg-[#001F1A]"
            } ${index % 2 === 1 ? "lg:order-1" : ""}`}>
              <img
                src={withBase(service.image)}
                alt={service.title}
                class="h-full w-full object-cover transition duration-500 hover:scale-[1.02]"
                loading="lazy"
                width="600"
                height="340"
              />
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="border-t border-white/[0.08] bg-[#001F1A] py-16 text-white text-center font-sans-tech">
    <div class="cx-shell max-w-3xl">
      <h2 class="font-serif-display text-2xl sm:text-3xl text-white">
        Precisa de suporte técnico especializado?
      </h2>
      <p class="mt-3 text-[14.5px] text-[#A7ACA8]">
        Converse diretamente com os engenheiros da Conexium e avalie a viabilidade técnica da sua demanda.
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a href={withBase("/contato/")} class="btn-gold">
          Solicitar diagnóstico →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
