---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ServiceCard from "@components/ServiceCard.astro";
import CtaBand from "@components/CtaBand.astro";
import { servicePages } from "@data/site";
import { withBase } from "@lib/urls";
---

<BaseLayout
  title="Serviços"
  description="Serviços de engenharia elétrica, consultoria técnico-regulatória, inteligência energética e eletromobilidade para projetos complexos."
  path="/servicos/"
>
  <PageHero
    eyebrow="Serviços"
    title="Engenharia, conexão, dados e infraestrutura para decisões técnicas seguras."
    description="A Kairós estrutura evidências, projetos e estratégias sem prometer aprovação ou resultado fora do controle técnico."
    primaryHref={withBase("/contato/")}
    primaryLabel="Solicitar diagnóstico técnico"
    secondaryHref={withBase("/para-integradores/")}
    secondaryLabel="Sou integrador"
  />

  <section class="bg-white px-5 py-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Frentes de atuação"
        title="Profundidade técnica sem promessas comerciais vazias."
        description="Cada serviço deixa explícito o que pode ser analisado, documentado e conduzido, respeitando escopo contratado e responsabilidade técnica."
      />
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {servicePages.map((service) => (
          <ServiceCard title={service.title} description={service.description} href={`/servicos/${service.slug}/`} eyebrow={service.eyebrow} />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 px-5 py-24 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <SectionHeading
        eyebrow="Como ler o escopo"
        title="O site informa capacidades técnicas, não substitui proposta comercial."
        description="Serviços como projeto executivo, laudo, ART, estudo especializado ou acompanhamento de obra dependem de escopo real contratado, documentos disponíveis e responsabilidade definida."
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {["Sem garantia de aprovação", "Sem números inventados", "Sem cliente fictício", "Com evidência rastreável"].map((item) => (
          <div class="reveal rounded-md border border-slate-200 bg-white p-6 shadow-crisp">
            <h2 class="text-lg font-semibold text-slate-950">{item}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">A comunicação técnica preserva limites profissionais e evita promessas incompatíveis com regulação ou contexto de rede.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
