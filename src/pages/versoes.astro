---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { withBase } from "@lib/urls";

const versions = [
  {
    label: "Versão atual",
    status: "Publicada e congelada",
    title: "Primeira dobra com vitrine técnica curada",
    description:
      "Snapshot do site atual após o aprimoramento premium da Home, com busca, filtros e cartões de análise técnica na primeira dobra.",
    href: "/versao-atual/",
    commit: "1a45e00",
  },
  {
    label: "Versão anterior",
    status: "Arquivada separadamente",
    title: "Experiência institucional anterior",
    description:
      "Snapshot preservado do commit imediatamente anterior à nova primeira dobra, mantendo layout, textos, links e assets próprios.",
    href: "/versao-anterior/",
    commit: "f1ecca9",
  },
];
---

<BaseLayout
  title="Versões do site"
  description="Acesse separadamente a versão atual e a versão anterior do site institucional da Conexium Engenharia."
  path="/versoes/"
>
  <PageHero
    eyebrow="Histórico público"
    title="Duas versões do site, separadas e acessíveis."
    description="A versão principal continua publicada na raiz do GitHub Pages. Os snapshots abaixo preservam a versão atual e a anterior em caminhos independentes."
    primaryHref={withBase("/versao-atual/")}
    primaryLabel="Abrir versão atual"
    secondaryHref={withBase("/versao-anterior/")}
    secondaryLabel="Abrir versão anterior"
  />

  <section class="bg-white px-5 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-2">
      {versions.map((version) => (
        <article class="reveal rounded-md border border-slate-200 bg-white p-7 shadow-crisp">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="eyebrow text-cx-teal">{version.label}</p>
            <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
              {version.status}
            </span>
          </div>
          <h2 class="mt-5 text-2xl font-semibold text-slate-950">{version.title}</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600">{version.description}</p>
          <dl class="mt-6 grid gap-3 border-t border-slate-200 pt-5 text-sm text-slate-600">
            <div class="flex items-center justify-between gap-4">
              <dt class="font-semibold text-slate-950">Commit</dt>
              <dd class="font-mono text-xs">{version.commit}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
              <dt class="font-semibold text-slate-950">Caminho</dt>
              <dd class="font-mono text-xs">{withBase(version.href)}</dd>
            </div>
          </dl>
          <a
            href={withBase(version.href)}
            class="mt-7 inline-flex items-center justify-center rounded-full bg-cx-void px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-cx-teal"
          >
            Acessar {version.label.toLowerCase()}
            <span class="ml-2" aria-hidden="true">-&gt;</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
